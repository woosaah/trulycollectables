<%- include('../partials/header') %>

<div class="container my-4">
    <!-- Mobile filter toggle button -->
    <div class="d-lg-none mb-3">
        <button class="btn btn-primary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#mobileFilters">
            <i class="bi bi-funnel"></i> Show Filters & Navigation
        </button>
    </div>

    <div class="row">
        <!-- Tree Navigation Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="collapse d-lg-block" id="mobileFilters">
                <!-- Tree Navigation -->
                <div class="filter-section mb-4">
                    <h5 class="mb-3">Browse by Collection</h5>
                    <div class="tree-navigation">
                    <!-- Sport Cards -->
                    <% if (navigationTree.sport && Object.keys(navigationTree.sport).length > 0) { %>
                    <div class="tree-level-1">
                        <div class="tree-item category">
                            <i class="bi bi-chevron-right tree-toggle"></i>
                            <strong>Sport Cards</strong>
                        </div>
                        <div class="tree-children" style="display: none;">
                            <% Object.keys(navigationTree.sport).sort().forEach(sportType => { %>
                                <div class="tree-level-2">
                                    <div class="tree-item sport-type">
                                        <i class="bi bi-chevron-right tree-toggle"></i>
                                        <strong><%= sportType %></strong>
                                    </div>
                                    <div class="tree-children" style="display: none;">
                                        <% Object.keys(navigationTree.sport[sportType]).sort().forEach(manufacturer => { %>
                                            <div class="tree-level-3">
                                                <div class="tree-item manufacturer">
                                                    <i class="bi bi-chevron-right tree-toggle"></i>
                                                    <%= manufacturer %>
                                                </div>
                                                <div class="tree-children" style="display: none;">
                                                    <% Object.keys(navigationTree.sport[sportType][manufacturer]).sort((a,b) => b - a).forEach(year => { %>
                                                        <div class="tree-level-4">
                                                            <div class="tree-item year">
                                                                <i class="bi bi-chevron-right tree-toggle"></i>
                                                                <%= year %>
                                                            </div>
                                                            <div class="tree-children" style="display: none;">
                                                                <% navigationTree.sport[sportType][manufacturer][year].forEach(set => { %>
                                                                    <div class="tree-level-5">
                                                                        <a href="?sport_type=<%= encodeURIComponent(sportType) %>&manufacturer=<%= encodeURIComponent(manufacturer) %>&year=<%= year !== 'No Year' ? year : '' %>&set_name=<%= encodeURIComponent(set.name) %>"
                                                                           class="tree-item set <%= filters.set_name === set.name ? 'active' : '' %>">
                                                                            <%= set.name %> (<%= set.count %>)
                                                                        </a>
                                                                    </div>
                                                                <% }); %>
                                                            </div>
                                                        </div>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                    <% } %>

                    <!-- Non-Sport Cards -->
                    <% if (navigationTree.non_sport && Object.keys(navigationTree.non_sport).length > 0) { %>
                    <div class="tree-level-1">
                        <div class="tree-item category">
                            <i class="bi bi-chevron-right tree-toggle"></i>
                            <strong>Non-Sport Cards</strong>
                        </div>
                        <div class="tree-children" style="display: none;">
                            <% Object.keys(navigationTree.non_sport).sort().forEach(manufacturer => { %>
                                <div class="tree-level-2">
                                    <div class="tree-item manufacturer">
                                        <i class="bi bi-chevron-right tree-toggle"></i>
                                        <%= manufacturer %>
                                    </div>
                                    <div class="tree-children" style="display: none;">
                                        <% Object.keys(navigationTree.non_sport[manufacturer]).sort((a,b) => b - a).forEach(year => { %>
                                            <div class="tree-level-3">
                                                <div class="tree-item year">
                                                    <i class="bi bi-chevron-right tree-toggle"></i>
                                                    <%= year %>
                                                </div>
                                                <div class="tree-children" style="display: none;">
                                                    <% navigationTree.non_sport[manufacturer][year].forEach(set => { %>
                                                        <div class="tree-level-4">
                                                            <a href="?manufacturer=<%= encodeURIComponent(manufacturer) %>&year=<%= year !== 'No Year' ? year : '' %>&set_name=<%= encodeURIComponent(set.name) %>"
                                                               class="tree-item set <%= filters.set_name === set.name ? 'active' : '' %>">
                                                                <%= set.name %> (<%= set.count %>)
                                                            </a>
                                                        </div>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- Search & Filters -->
            <div class="filter-section">
                <h5 class="mb-3">Search & Filters</h5>
                <form action="/cards" method="GET">
                    <!-- Search -->
                    <div class="mb-3">
                        <label class="form-label">Search</label>
                        <input type="text" class="form-control" name="search" value="<%= filters.search || '' %>" placeholder="Card name, set, number...">
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select class="form-select" name="card_category">
                            <option value="">All Categories</option>
                            <option value="sport" <%= filters.card_category === 'sport' ? 'selected' : '' %>>Sport</option>
                            <option value="non_sport" <%= filters.card_category === 'non_sport' ? 'selected' : '' %>>Non-Sport</option>
                        </select>
                    </div>

                    <!-- Sport Type -->
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <select class="form-select" name="sport_type">
                            <option value="">All Types</option>
                            <% sportTypes.forEach(sport => { %>
                            <option value="<%= sport %>" <%= filters.sport_type === sport ? 'selected' : '' %>><%= sport %></option>
                            <% }); %>
                        </select>
                    </div>

                    <!-- Set Name -->
                    <div class="mb-3">
                        <label class="form-label">Set</label>
                        <select class="form-select" name="set_name">
                            <option value="">All Sets</option>
                            <% sets.forEach(set => { %>
                            <option value="<%= set %>" <%= filters.set_name === set ? 'selected' : '' %>><%= set %></option>
                            <% }); %>
                        </select>
                    </div>

                    <!-- Condition -->
                    <div class="mb-3">
                        <label class="form-label">Condition</label>
                        <select class="form-select" name="condition">
                            <option value="">All Conditions</option>
                            <option value="mint" <%= filters.condition === 'mint' ? 'selected' : '' %>>Mint</option>
                            <option value="near_mint" <%= filters.condition === 'near_mint' ? 'selected' : '' %>>Near Mint</option>
                            <option value="excellent" <%= filters.condition === 'excellent' ? 'selected' : '' %>>Excellent</option>
                            <option value="good" <%= filters.condition === 'good' ? 'selected' : '' %>>Good</option>
                            <option value="played" <%= filters.condition === 'played' ? 'selected' : '' %>>Played</option>
                        </select>
                    </div>

                    <!-- Price Range -->
                    <div class="mb-3">
                        <label class="form-label">Price Range (NZD)</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" class="form-control" name="min_price" value="<%= filters.min_price || '' %>" placeholder="Min" step="0.01">
                            </div>
                            <div class="col-6">
                                <input type="number" class="form-control" name="max_price" value="<%= filters.max_price || '' %>" placeholder="Max" step="0.01">
                            </div>
                        </div>
                    </div>

                    <!-- Sort -->
                    <div class="mb-3">
                        <label class="form-label">Sort By</label>
                        <select class="form-select" name="sort">
                            <option value="created_at" <%= filters.sort === 'created_at' ? 'selected' : '' %>>Newest</option>
                            <option value="price_nzd" <%= filters.sort === 'price_nzd' ? 'selected' : '' %>>Price</option>
                            <option value="card_name" <%= filters.sort === 'card_name' ? 'selected' : '' %>>Name</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <select class="form-select" name="order">
                            <option value="desc" <%= filters.order === 'desc' ? 'selected' : '' %>>Descending</option>
                            <option value="asc" <%= filters.order === 'asc' ? 'selected' : '' %>>Ascending</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-2">Apply Filters</button>
                    <a href="/cards" class="btn btn-outline-secondary w-100">Clear Filters</a>
                </form>
            </div>
            </div> <!-- Close collapse -->
        </div>

        <!-- Cards Grid -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><%= totalCards %> Cards Found</h2>
            </div>

            <% if (cards && cards.length > 0) { %>
            <div class="product-grid">
                <% const collectionSet = new Set(collectionCardIds || []); %>
                <% cards.forEach(card => { %>
                <div class="card">
                    <% if (card.image_front) { %>
                    <div class="position-relative">
                        <img src="<%= card.image_front %>"
                             class="card-img-top card-lightbox-trigger"
                             alt="<%= card.card_name %>"
                             data-image="<%= card.image_front %>"
                             data-title="<%= card.card_name.replace(/"/g, '&quot;') %>"
                             style="cursor: pointer;">
                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge bg-dark bg-opacity-75" style="font-size: 0.7rem;">
                                <i class="bi bi-zoom-in"></i>
                            </span>
                        </div>
                        <% if (collectionSet.has(card.id)) { %>
                        <div class="position-absolute top-0 start-0 m-2">
                            <span class="badge bg-success" style="font-size: 0.7rem;">
                                <i class="bi bi-check-circle-fill"></i> Have it
                            </span>
                        </div>
                        <% } %>
                    </div>
                    <% } else { %>
                    <div class="card-img-top d-flex align-items-center justify-content-center bg-light">
                        <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                    </div>
                    <% } %>
                    <a href="/cards/<%= card.id %>" class="text-decoration-none">
                        <div class="card-body">
                            <h5 class="card-title text-dark"><%= card.card_name %></h5>
                            <p class="card-text text-muted small mb-2">
                                <%= card.set_name || 'N/A' %>
                                <% if (card.card_number) { %>#<%= card.card_number %><% } %>
                                <% if (card.year) { %>(<%= card.year %>)<% } %>
                            </p>
                            <% if (card.condition) { %>
                            <span class="badge badge-<%= card.condition.toLowerCase().replace(/[^a-z]/g, '') %> mb-2">
                                <%= card.condition %>
                            </span>
                            <% } %>
                            <% if (card.price_nzd) { %>
                            <div class="price-tag">NZD $<%= parseFloat(card.price_nzd).toFixed(2) %></div>
                            <% } else { %>
                            <span class="badge bg-secondary">Price TBC</span>
                            <% } %>
                            <% if (card.quantity > 0) { %>
                            <p class="mb-0 mt-1 small"><i class="bi bi-circle-fill text-success" style="font-size:0.5rem;vertical-align:middle;"></i> In stock</p>
                            <% } else { %>
                            <p class="mb-0 mt-1 small"><i class="bi bi-circle-fill text-danger" style="font-size:0.5rem;vertical-align:middle;"></i> Out of stock</p>
                            <% } %>
                        </div>
                    </a>
                </div>
                <% }); %>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
            <%
                // Build query string from filters
                const queryParams = [];
                Object.keys(filters).forEach(key => {
                    if (filters[key] && filters[key] !== '') {
                        queryParams.push(`${key}=${encodeURIComponent(filters[key])}`);
                    }
                });
                const filterQuery = queryParams.length > 0 ? '&' + queryParams.join('&') : '';
            %>
            <nav class="mt-4">
                <%- include('../partials/pagination', { currentPage, totalPages, hrefFor: p => '?page=' + (p) + (filterQuery) }) %>
            </nav>
            <% } %>
            <% } else { %>
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No cards found matching your criteria.
            </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Lightbox Modal -->
<div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark">
            <div class="modal-header border-0">
                <h5 class="modal-title text-white" id="lightboxLabel">Card Image</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <img id="lightboxImage" src="" class="img-fluid w-100" alt="Card image">
            </div>
        </div>
    </div>
</div>

<style>
.tree-navigation {
    font-size: 0.9rem;
}

.tree-item {
    padding: 0.4rem 0.5rem;
    cursor: pointer;
    border-radius: 4px;
    transition: background-color 0.2s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.tree-item:hover {
    background-color: #f8f9fa;
}

.tree-item.set {
    text-decoration: none;
    color: #333;
    padding-left: 1.5rem;
}

.tree-item.set:hover {
    background-color: #e9ecef;
    color: #0d6efd;
}

.tree-item.set.active {
    background-color: #0d6efd;
    color: white;
    font-weight: 500;
}

.tree-toggle {
    font-size: 0.8rem;
    transition: transform 0.2s;
    cursor: pointer;
}

.tree-toggle.expanded {
    transform: rotate(90deg);
}

.tree-level-2 {
    padding-left: 0.75rem;
}

.tree-level-3 {
    padding-left: 0.75rem;
}

.tree-level-4 {
    padding-left: 0.75rem;
}

.tree-level-5 {
    padding-left: 0.5rem;
}

.tree-children {
    margin-top: 0.25rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Tree navigation toggle
    document.querySelectorAll('.tree-toggle').forEach(function(toggle) {
        toggle.addEventListener('click', function(e) {
            e.stopPropagation();
            const parent = this.closest('.tree-level-1, .tree-level-2, .tree-level-3, .tree-level-4, .tree-level-5');
            const children = parent.querySelector('.tree-children');

            if (children.style.display === 'none') {
                children.style.display = 'block';
                this.classList.add('expanded');
            } else {
                children.style.display = 'none';
                this.classList.remove('expanded');
            }
        });
    });

    // Auto-expand selected set's parents
    const activeSet = document.querySelector('.tree-item.set.active');
    if (activeSet) {
        let parent = activeSet.closest('.tree-children');
        while (parent) {
            parent.style.display = 'block';
            const toggle = parent.previousElementSibling.querySelector('.tree-toggle');
            if (toggle) {
                toggle.classList.add('expanded');
            }
            parent = parent.parentElement.closest('.tree-children');
        }
    }

    // Add click event listeners to all card images
    document.querySelectorAll('.card-lightbox-trigger').forEach(function(img) {
        img.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const imageUrl = this.getAttribute('data-image');
            const cardName = this.getAttribute('data-title');
            document.getElementById('lightboxImage').src = imageUrl;
            document.getElementById('lightboxLabel').textContent = cardName;
            const modal = new bootstrap.Modal(document.getElementById('lightboxModal'));
            modal.show();
        });
    });

    // Keyboard navigation for lightbox
    document.addEventListener('keydown', function(e) {
        const modal = document.getElementById('lightboxModal');
        if (modal && modal.classList.contains('show') && e.key === 'Escape') {
            bootstrap.Modal.getInstance(modal).hide();
        }
    });
});
</script>

<%- include('../partials/footer') %>
