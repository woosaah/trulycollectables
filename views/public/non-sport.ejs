<%- include('../partials/header') %>

<div class="container my-4">
    <h2 class="mb-4">Non-Sport Cards</h2>

    <div class="card mb-4">
        <div class="card-body">
            <form action="/non-sport" method="GET" class="row g-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" name="search" value="<%= filters.search || '' %>" placeholder="Search cards...">
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="sport_type">
                        <option value="">All Types</option>
                        <% sportTypes.forEach(type => { %>
                        <option value="<%= type %>" <%= filters.sport_type === type ? 'selected' : '' %>><%= type %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="sort">
                        <option value="created_at" <%= filters.sort === 'created_at' ? 'selected' : '' %>>Newest</option>
                        <option value="price_nzd" <%= filters.sort === 'price_nzd' ? 'selected' : '' %>>Price</option>
                        <option value="card_name" <%= filters.sort === 'card_name' ? 'selected' : '' %>>Name</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <p class="text-muted"><%= totalCards %> card<%= totalCards !== 1 ? 's' : '' %> found</p>

    <% if (cards.length > 0) { %>
    <div class="product-grid">
        <% cards.forEach(card => { %>
        <a href="/cards/<%= card.id %>" class="text-decoration-none">
            <div class="card h-100">
                <% if (card.image_front) { %>
                <img src="<%= card.image_front %>" class="card-img-top" alt="<%= card.card_name %>">
                <% } else { %>
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center">
                    <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                </div>
                <% } %>
                <div class="card-body">
                    <h6 class="card-title text-dark"><%= card.card_name %></h6>
                    <p class="text-muted small mb-1"><%= card.set_name || '' %><% if (card.card_number) { %> <span class="fw-semibold">#<%= card.card_number %></span><% } %></p>
                    <% if (card.sport_type) { %><span class="badge bg-secondary mb-1"><%= card.sport_type %></span><% } %>
                    <br><% if (card.price_nzd) { %><span class="price-tag">$<%= card.price_nzd.toFixed(2) %></span><% } else { %><span class="badge bg-secondary">Price TBC</span><% } %>
                    <% if (card.quantity > 0) { %>
                    <p class="mb-0 mt-1 small"><i class="bi bi-circle-fill text-success" style="font-size:0.5rem;vertical-align:middle;"></i> In stock</p>
                    <% } else { %>
                    <p class="mb-0 mt-1 small"><i class="bi bi-circle-fill text-danger" style="font-size:0.5rem;vertical-align:middle;"></i> Out of stock</p>
                    <% } %>
                </div>
            </div>
        </a>
        <% }); %>
    </div>

    <% if (totalPages > 1) { %>
    <%
        const qs = (p) => {
            const params = new URLSearchParams();
            params.set('page', p);
            if (filters.search) params.set('search', filters.search);
            if (filters.sport_type) params.set('sport_type', filters.sport_type);
            if (filters.sort && filters.sort !== 'created_at') params.set('sort', filters.sort);
            return '?' + params.toString();
        };
    %>
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="<%= qs(currentPage - 1) %>">Previous</a>
            </li>
            <% for (let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link" href="<%= qs(i) %>"><%= i %></a>
            </li>
            <% } %>
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="<%= qs(currentPage + 1) %>">Next</a>
            </li>
        </ul>
    </nav>
    <% } %>
    <% } else { %>
    <div class="alert alert-info">No non-sport cards found.</div>
    <% } %>
</div>

<%- include('../partials/footer') %>
