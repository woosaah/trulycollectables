<%- include('../partials/header') %>

<div class="container my-4">
    <div class="row">
        <!-- Filters Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="filter-section">
                <h5 class="mb-3">Filters</h5>
                <form action="/accessories" method="GET">
                    <!-- Search -->
                    <div class="mb-3">
                        <label class="form-label">Search</label>
                        <input type="text" class="form-control" name="search" value="<%= filters.search || '' %>" placeholder="Search accessories...">
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select class="form-select" name="category">
                            <option value="">All Categories</option>
                            <% categories.forEach(category => { %>
                            <option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option>
                            <% }); %>
                        </select>
                    </div>

                    <!-- Price Range -->
                    <div class="mb-3">
                        <label class="form-label">Price Range (NZD)</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" class="form-control" name="min_price" value="<%= filters.min_price || '' %>" placeholder="Min" step="0.01">
                            </div>
                            <div class="col-6">
                                <input type="number" class="form-control" name="max_price" value="<%= filters.max_price || '' %>" placeholder="Max" step="0.01">
                            </div>
                        </div>
                    </div>

                    <!-- Sort -->
                    <div class="mb-3">
                        <label class="form-label">Sort By</label>
                        <select class="form-select" name="sort">
                            <option value="created_at" <%= filters.sort === 'created_at' ? 'selected' : '' %>>Newest</option>
                            <option value="price_nzd" <%= filters.sort === 'price_nzd' ? 'selected' : '' %>>Price</option>
                            <option value="product_name" <%= filters.sort === 'product_name' ? 'selected' : '' %>>Name</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <select class="form-select" name="order">
                            <option value="desc" <%= filters.order === 'desc' ? 'selected' : '' %>>Descending</option>
                            <option value="asc" <%= filters.order === 'asc' ? 'selected' : '' %>>Ascending</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-2">Apply Filters</button>
                    <a href="/accessories" class="btn btn-outline-secondary w-100">Clear Filters</a>
                </form>
            </div>
        </div>

        <!-- Accessories Grid -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><%= totalAccessories %> Accessories Found</h2>
            </div>

            <% if (accessories && accessories.length > 0) { %>
            <div class="product-grid">
                <% accessories.forEach(accessory => { %>
                <div class="card">
                    <a href="/accessories/<%= accessory.id %>" class="text-decoration-none">
                        <% if (accessory.image_url) { %>
                        <img src="<%= accessory.image_url %>" class="card-img-top" alt="<%= accessory.product_name %>">
                        <% } else { %>
                        <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height: 200px;">
                            <i class="bi bi-box-seam text-muted" style="font-size: 3rem;"></i>
                        </div>
                        <% } %>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-dark"><%= accessory.product_name %></h5>
                            <% if (accessory.category) { %>
                            <span class="badge bg-secondary mb-2 align-self-start"><%= accessory.category %></span>
                            <% } %>
                            <% if (isSocietyMember && accessory.society_price && accessory.society_price < accessory.price_nzd) { %>
                                <div class="price-tag">
                                    <span class="text-decoration-line-through text-muted">$<%= parseFloat(accessory.price_nzd).toFixed(2) %></span>
                                    <span class="text-success fw-bold ms-1">$<%= parseFloat(accessory.society_price).toFixed(2) %></span>
                                </div>
                            <% } else { %>
                                <div class="price-tag">From NZD $<%= parseFloat(accessory.price_nzd).toFixed(2) %></div>
                            <% } %>
                            <div class="mt-auto pt-2">
                                <% if (!accessory.available) { %>
                                    <p class="text-danger small mb-0">Out of stock</p>
                                <% } else { %>
                                    <span class="btn btn-outline-primary btn-sm w-100">View Details</span>
                                <% } %>
                            </div>
                        </div>
                    </a>
                </div>
                <% }); %>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
            <%
                var cleanFilters = {};
                Object.keys(filters).forEach(function(k) {
                    if (filters[k] && filters[k] !== 'null' && filters[k] !== 'undefined') cleanFilters[k] = filters[k];
                });
                var filterParams = new URLSearchParams(cleanFilters).toString();
                var filterStr = filterParams ? '&' + filterParams : '';
            %>
            <nav class="mt-4">
                <%- include('../partials/pagination', { currentPage, totalPages, hrefFor: p => '?page=' + (p) + (filterStr) }) %>
            </nav>
            <% } %>
            <% } else { %>
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No accessories found matching your criteria.
            </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
