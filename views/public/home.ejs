<%- include('../partials/header') %>

<!-- Hero Section -->
<div class="hero text-center">
    <div class="container">
        <h1 class="mb-3">Truly Collectables</h1>
        <p class="lead mb-4">Sport &amp; non-sport trading cards, accessories, and collectables — based in New Zealand</p>
        <div class="mt-3 d-flex justify-content-center gap-2 flex-wrap">
            <a href="/sport-cards" class="btn btn-light btn-lg"><i class="bi bi-trophy"></i> Sport Cards</a>
            <a href="/non-sport" class="btn btn-light btn-lg"><i class="bi bi-stars"></i> Non-Sport</a>
            <a href="/accessories" class="btn btn-outline-light btn-lg">Accessories</a>
        </div>
    </div>
</div>

<div class="container">
    <!-- Our Products -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="border-bottom-custom pb-2 mb-0">Our Products</h2>
            <a href="/accessories" class="text-decoration-none">View All <i class="bi bi-arrow-right"></i></a>
        </div>

        <% if ((featuredAccessories && featuredAccessories.length > 0) || (figurines && figurines.length > 0)) { %>
        <div class="product-grid">
            <% if (figurines && figurines.length > 0) { %>
            <% figurines.forEach(figurine => { %>
            <a href="/figurines/<%= figurine.id %>" class="text-decoration-none">
                <div class="card h-100 hover-shadow">
                    <% if (figurine.image_url) { %>
                    <img src="<%= figurine.image_url %>" class="card-img-top" alt="<%= figurine.product_name %>">
                    <% } else { %>
                    <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height: 200px;">
                        <i class="bi bi-trophy text-muted" style="font-size: 3rem;"></i>
                    </div>
                    <% } %>
                    <div class="card-body">
                        <h5 class="card-title"><%= figurine.product_name %></h5>
                        <span class="badge bg-info mb-2">Figurine</span>
                        <div class="price-tag">NZD $<%= parseFloat(figurine.price_nzd).toFixed(2) %></div>
                        <% if (figurine.quantity > 0) { %>
                        <p class="text-muted small mb-0 mt-1"><%= figurine.quantity %> in stock</p>
                        <% } else { %>
                        <p class="text-danger small mb-0 mt-1">Out of stock</p>
                        <% } %>
                    </div>
                </div>
            </a>
            <% }); %>
            <% } %>
            <% if (featuredAccessories && featuredAccessories.length > 0) { %>
            <% featuredAccessories.forEach(accessory => { %>
            <a href="/accessories/<%= accessory.id %>" class="text-decoration-none">
                <div class="card h-100 hover-shadow">
                    <% if (accessory.image_url) { %>
                    <img src="<%= accessory.image_url %>" class="card-img-top" alt="<%= accessory.product_name %>">
                    <% } else { %>
                    <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height: 200px;">
                        <i class="bi bi-box-seam text-muted" style="font-size: 3rem;"></i>
                    </div>
                    <% } %>
                    <div class="card-body">
                        <h5 class="card-title"><%= accessory.product_name %></h5>
                        <% if (accessory.category) { %>
                        <span class="badge bg-secondary mb-2"><%= accessory.category %></span>
                        <% } %>
                        <p class="card-text text-muted small mb-2"><%= accessory.manufacturer || '' %></p>
                        <%
                            let displayPrice = parseFloat(accessory.price_nzd);
                            let displaySocietyPrice = accessory.society_price ? parseFloat(accessory.society_price) : null;
                            let hasVariants = accessory.variants && (typeof accessory.variants === 'string' ? JSON.parse(accessory.variants) : accessory.variants).length > 0;
                        %>
                        <% if (isSocietyMember && displaySocietyPrice && displaySocietyPrice < displayPrice) { %>
                            <div class="price-tag">
                                <% if (hasVariants) { %>From <% } %>
                                <span class="text-decoration-line-through text-muted">$<%= displayPrice.toFixed(2) %></span>
                                <span class="text-success fw-bold ms-1">$<%= displaySocietyPrice.toFixed(2) %></span>
                            </div>
                            <span class="badge bg-success small">Society Member Price</span>
                        <% } else { %>
                            <div class="price-tag"><% if (hasVariants) { %>From <% } %>NZD $<%= displayPrice.toFixed(2) %></div>
                        <% } %>
                        <% if (accessory.quantity > 0) { %>
                        <p class="text-muted small mb-0 mt-1"><%= accessory.quantity %> in stock</p>
                        <% } else { %>
                        <p class="text-danger small mb-0 mt-1">Out of stock</p>
                        <% } %>
                    </div>
                </div>
            </a>
            <% }); %>
            <% } %>
        </div>
        <% } else { %>
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No products available at the moment.
        </div>
        <% } %>
    </section>

    <!-- Players Section -->
    <% if (locals.featuredPlayers && featuredPlayers.length > 0) { %>
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="border-bottom-custom pb-2 mb-0">Featured Players</h2>
            <a href="/players" class="text-decoration-none">View All <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row g-3">
            <% featuredPlayers.forEach(player => { %>
            <div class="col-6 col-md-4 col-lg-3">
                <a href="/players/<%= player.id %>" class="text-decoration-none">
                    <div class="card h-100 text-center hover-shadow">
                        <div class="card-body py-3">
                            <% if (player.image_url) { %>
                            <img src="<%= player.image_url %>" class="rounded-circle mb-2" style="width: 70px; height: 70px; object-fit: cover;">
                            <% } else { %>
                            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-2" style="width: 70px; height: 70px;">
                                <i class="bi bi-person text-muted" style="font-size: 1.8rem;"></i>
                            </div>
                            <% } %>
                            <h6 class="card-title text-dark mb-1"><%= player.name %></h6>
                            <div class="mb-1">
                                <% if (player.born_in_nz) { %><span class="badge bg-success" style="font-size:0.65rem;">NZ</span><% } %>
                                <% if (player.sports_played) { player.sports_played.slice(0,2).forEach(s => { %><span class="badge bg-secondary" style="font-size:0.65rem;"><%= s %></span><% }); } %>
                            </div>
                            <p class="text-muted small mb-0"><%= player.card_count %> card<%= player.card_count != 1 ? 's' : '' %></p>
                        </div>
                    </div>
                </a>
            </div>
            <% }); %>
        </div>
    </section>
    <% } %>

    <!-- Features Section -->
    <section class="mb-5">
        <h2 class="mb-4 border-bottom-custom pb-2">Why Choose Us?</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="text-center">
                    <i class="bi bi-shield-check text-primary" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Quality Products</h5>
                    <p class="text-muted">Trusted brands like Ultra Pro</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center">
                    <i class="bi bi-people text-primary" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Society Members Save</h5>
                    <p class="text-muted">Exclusive pricing for members</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center">
                    <i class="bi bi-collection text-primary" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">For Collectors</h5>
                    <p class="text-muted">Everything you need to protect your collection</p>
                </div>
            </div>
        </div>
    </section>
</div>

<%- include('../partials/footer') %>
