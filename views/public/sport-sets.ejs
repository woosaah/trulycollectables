<%- include('../partials/header') %>

<div class="container my-4">
    <h2 class="mb-4">Sport Sets</h2>

    <div class="card mb-4">
        <div class="card-body">
            <form action="/sport-sets" method="GET" class="row g-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" name="search" value="<%= filters.search || '' %>" placeholder="Search sets...">
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="sport_type">
                        <option value="">All Sports</option>
                        <% sportTypes.forEach(type => { %>
                        <option value="<%= type %>" <%= filters.sport_type === type ? 'selected' : '' %>><%= type %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="manufacturer">
                        <option value="">All Manufacturers</option>
                        <% manufacturers.forEach(mfg => { %>
                        <option value="<%= mfg %>" <%= filters.manufacturer === mfg ? 'selected' : '' %>><%= mfg %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <p class="text-muted"><%= totalSets %> set<%= totalSets !== 1 ? 's' : '' %> found</p>

    <% if (sets.length > 0) { %>
    <div class="product-grid">
        <% sets.forEach(set => { %>
        <a href="/sport-cards?set_name=<%= encodeURIComponent(set.set_name) %>" class="text-decoration-none">
            <div class="card h-100">
                <% if (set.image_url) { %>
                <img src="<%= set.image_url %>" class="card-img-top" alt="<%= set.set_name %>">
                <% } else { %>
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center">
                    <i class="bi bi-collection text-muted" style="font-size: 3rem;"></i>
                </div>
                <% } %>
                <div class="card-body">
                    <h6 class="card-title text-dark"><%= set.set_name %></h6>
                    <p class="text-muted small mb-1">
                        <%= set.manufacturer || '' %>
                        <% if (set.year) { %> &middot; <%= set.year %><% } %>
                    </p>
                    <% if (set.sport_type) { %>
                    <span class="badge bg-primary"><%= set.sport_type %></span>
                    <% } %>
                </div>
            </div>
        </a>
        <% }); %>
    </div>

    <% if (totalPages > 1) { %>
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage - 1 %>&search=<%= filters.search || '' %>">Previous</a>
            </li>
            <% for (let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %>&search=<%= filters.search || '' %>"><%= i %></a>
            </li>
            <% } %>
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage + 1 %>&search=<%= filters.search || '' %>">Next</a>
            </li>
        </ul>
    </nav>
    <% } %>
    <% } else { %>
    <div class="alert alert-info">No sport sets found.</div>
    <% } %>
</div>

<%- include('../partials/footer') %>
