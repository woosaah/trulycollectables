<%- include('../partials/header') %>

<div class="container my-4">
    <h2 class="mb-4">Boxes & Packs</h2>

    <div class="card mb-4">
        <div class="card-body">
            <form action="/boxes-packs" method="GET" class="row g-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" name="search" value="<%= filters.search || '' %>" placeholder="Search boxes & packs...">
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="sport_type">
                        <option value="">All Types</option>
                        <% sportTypes.forEach(type => { %>
                        <option value="<%= type %>" <%= filters.sport_type === type ? 'selected' : '' %>><%= type %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Boxes -->
    <% if (boxes.length > 0) { %>
    <h4 class="mb-3"><i class="bi bi-box"></i> Boxes (<%= totalBoxes %>)</h4>
    <div class="product-grid mb-4">
        <% boxes.forEach(card => { %>
        <a href="/cards/<%= card.id %>" class="text-decoration-none">
            <div class="card h-100">
                <% if (card.image_front) { %>
                <img src="<%= card.image_front %>" class="card-img-top" alt="<%= card.card_name %>">
                <% } else { %>
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center">
                    <i class="bi bi-box text-muted" style="font-size: 3rem;"></i>
                </div>
                <% } %>
                <div class="card-body">
                    <h6 class="card-title text-dark"><%= card.card_name %></h6>
                    <p class="text-muted small mb-1"><%= card.set_name || '' %><% if (card.card_number) { %> <span class="fw-semibold">#<%= card.card_number %></span><% } %></p>
                    <span class="badge bg-dark mb-2">Box</span>
                    <br><span class="price-tag">$<%= card.price_nzd ? card.price_nzd.toFixed(2) : '0.00' %></span>
                    <% if (card.quantity > 0) { %>
                    <p class="mb-0 mt-1 small"><i class="bi bi-circle-fill text-success" style="font-size:0.5rem;vertical-align:middle;"></i> In stock</p>
                    <% } else { %>
                    <p class="mb-0 mt-1 small"><i class="bi bi-circle-fill text-danger" style="font-size:0.5rem;vertical-align:middle;"></i> Out of stock</p>
                    <% } %>
                </div>
            </div>
        </a>
        <% }); %>
    </div>
    <% } %>

    <!-- Packs -->
    <% if (packs.length > 0) { %>
    <h4 class="mb-3"><i class="bi bi-stack"></i> Packs (<%= totalPacks %>)</h4>
    <div class="product-grid mb-4">
        <% packs.forEach(card => { %>
        <a href="/cards/<%= card.id %>" class="text-decoration-none">
            <div class="card h-100">
                <% if (card.image_front) { %>
                <img src="<%= card.image_front %>" class="card-img-top" alt="<%= card.card_name %>">
                <% } else { %>
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center">
                    <i class="bi bi-stack text-muted" style="font-size: 3rem;"></i>
                </div>
                <% } %>
                <div class="card-body">
                    <h6 class="card-title text-dark"><%= card.card_name %></h6>
                    <p class="text-muted small mb-1"><%= card.set_name || '' %><% if (card.card_number) { %> <span class="fw-semibold">#<%= card.card_number %></span><% } %></p>
                    <span class="badge bg-info mb-2">Pack</span>
                    <br><span class="price-tag">$<%= card.price_nzd ? card.price_nzd.toFixed(2) : '0.00' %></span>
                    <% if (card.quantity > 0) { %>
                    <p class="mb-0 mt-1 small"><i class="bi bi-circle-fill text-success" style="font-size:0.5rem;vertical-align:middle;"></i> In stock</p>
                    <% } else { %>
                    <p class="mb-0 mt-1 small"><i class="bi bi-circle-fill text-danger" style="font-size:0.5rem;vertical-align:middle;"></i> Out of stock</p>
                    <% } %>
                </div>
            </div>
        </a>
        <% }); %>
    </div>
    <% } %>

    <% if (boxes.length === 0 && packs.length === 0) { %>
    <div class="alert alert-info">No boxes or packs available yet.</div>
    <% } %>
</div>

<%- include('../partials/footer') %>
