<%- include('../partials/header') %>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h2 class="mb-4">Edit Card</h2>

            <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show">
                <%= success === 'images_added' ? 'Images added successfully!' :
                    success === 'image_deleted' ? 'Image deleted successfully!' :
                    success === 'variation_added' ? 'Variation added!' :
                    success === 'variation_updated' ? 'Variation updated!' :
                    success === 'variation_deleted' ? 'Variation deleted!' :
                    'Card updated successfully!' %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

            <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show">
                <%= error === 'no_images' ? 'Please select at least one image' :
                    error === 'add_failed' ? 'Failed to add images' :
                    error === 'delete_failed' ? 'Failed to delete image' :
                    error === 'variation_failed' ? 'Failed to save variation' :
                    'An error occurred' %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

            <div class="card">
                <div class="card-body">
                    <form action="/admin/cards/<%= card.id %>/edit" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="card_name" class="form-label">Card Name *</label>
                            <input type="text" class="form-control" id="card_name" name="card_name"
                                   value="<%= card.card_name %>" required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="manufacturer" class="form-label">Manufacturer</label>
                                <div class="input-group">
                                    <select class="form-select" id="manufacturer" name="manufacturer" data-current="<%= card.manufacturer || '' %>">
                                        <option value="">Loading...</option>
                                    </select>
                                    <button class="btn btn-outline-secondary" type="button" id="addManufacturerBtn">
                                        <i class="bi bi-plus"></i> New
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="set_name" class="form-label">Set Name</label>
                                <div class="input-group">
                                    <select class="form-select" id="set_name" name="set_name" data-current="<%= card.set_name || '' %>" disabled>
                                        <option value="">Select manufacturer first</option>
                                    </select>
                                    <button class="btn btn-outline-secondary" type="button" id="addSetBtn" disabled>
                                        <i class="bi bi-plus"></i> New
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="insert_list" class="form-label">Insert/Subset (Optional)</label>
                            <div class="input-group">
                                <select class="form-select" id="insert_list" name="insert_list" data-current="<%= card.insert_list || '' %>" disabled>
                                    <option value="">Select set first</option>
                                </select>
                                <button class="btn btn-outline-secondary" type="button" id="addInsertBtn" disabled>
                                    <i class="bi bi-plus"></i> New
                                </button>
                            </div>
                            <small class="text-muted">e.g., Master, Double Trouble, Rookies, etc.</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="card_number" class="form-label">Card Number</label>
                                <input type="text" class="form-control" id="card_number" name="card_number"
                                       value="<%= card.card_number || '' %>">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="year" class="form-label">Year</label>
                                <input type="number" class="form-control" id="year" name="year"
                                       value="<%= card.year || '' %>">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="card_category" class="form-label">Category *</label>
                                <select class="form-select" id="card_category" name="card_category" required>
                                    <option value="">Select Category...</option>
                                    <option value="sport" <%= card.card_category === 'sport' ? 'selected' : '' %>>Sport</option>
                                    <option value="non_sport" <%= card.card_category === 'non_sport' ? 'selected' : '' %>>Non-Sport</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="sport_type" class="form-label">Sport/Type</label>
                                <div class="input-group">
                                    <select class="form-select" id="sport_type" name="sport_type" data-current="<%= card.sport_type || '' %>">
                                        <option value="">Loading...</option>
                                    </select>
                                    <button class="btn btn-outline-secondary" type="button" id="addSportTypeBtn">
                                        <i class="bi bi-plus"></i> New
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="condition" class="form-label">Condition</label>
                                <select class="form-select" id="condition" name="condition">
                                    <option value="">Select...</option>
                                    <option value="mint" <%= card.condition === 'mint' ? 'selected' : '' %>>Mint</option>
                                    <option value="near_mint" <%= card.condition === 'near_mint' ? 'selected' : '' %>>Near Mint</option>
                                    <option value="excellent" <%= card.condition === 'excellent' ? 'selected' : '' %>>Excellent</option>
                                    <option value="good" <%= card.condition === 'good' ? 'selected' : '' %>>Good</option>
                                    <option value="played" <%= card.condition === 'played' ? 'selected' : '' %>>Played</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="price_nzd" class="form-label">Price (NZD) *</label>
                                <input type="number" class="form-control" id="price_nzd" name="price_nzd"
                                       step="0.01" min="0" value="<%= card.price_nzd %>" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="quantity" class="form-label">Quantity *</label>
                                <input type="number" class="form-control" id="quantity" name="quantity"
                                       min="0" value="<%= card.quantity %>" required>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="product_type" class="form-label">Product Type</label>
                                <select class="form-select" id="product_type" name="product_type">
                                    <option value="single" <%= card.product_type === 'single' ? 'selected' : '' %>>Single Card</option>
                                    <option value="pack" <%= card.product_type === 'pack' ? 'selected' : '' %>>Pack</option>
                                    <option value="box" <%= card.product_type === 'box' ? 'selected' : '' %>>Box</option>
                                </select>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="team" class="form-label">Team</label>
                                <input type="text" class="form-control" id="team" name="team"
                                       value="<%= card.team || '' %>" placeholder="e.g. All Blacks, Warriors">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="variation" class="form-label">Variation</label>
                                <select class="form-select" id="variation" name="variation">
                                    <option value="">None</option>
                                    <option value="Error" <%= card.variation === 'Error' ? 'selected' : '' %>>Error</option>
                                    <option value="Correction" <%= card.variation === 'Correction' ? 'selected' : '' %>>Correction</option>
                                    <option value="UER" <%= card.variation === 'UER' ? 'selected' : '' %>>UER</option>
                                    <option value="Short Print" <%= card.variation === 'Short Print' ? 'selected' : '' %>>Short Print</option>
                                    <option value="Other" <%= card.variation === 'Other' ? 'selected' : '' %>>Other</option>
                                </select>
                            </div>

                            <div class="col-md-4 mb-3 d-flex align-items-end">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="is_rookie_card" name="is_rookie_card"
                                           <%= card.is_rookie_card ? 'checked' : '' %>>
                                    <label class="form-check-label" for="is_rookie_card">
                                        <strong>RC</strong> - Rookie Card
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="player_id" class="form-label">Player</label>
                                <select class="form-select" id="player_id" name="player_id" data-current="<%= card.player_id || '' %>">
                                    <option value="">No player linked</option>
                                </select>
                                <small class="text-muted">Type to search players</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="notes" class="form-label">Notes</label>
                            <textarea class="form-control" id="notes" name="notes" rows="2" placeholder="Internal notes about this card..."><%= card.notes || '' %></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="3"><%= card.description || '' %></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="image_front" class="form-label">Front Image</label>
                                <% if (card.image_front) { %>
                                <img src="<%= card.image_front %>" class="img-thumbnail mb-2" style="max-height: 150px;">
                                <% } %>
                                <input type="file" class="form-control" id="image_front" name="image_front" accept="image/*">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="image_back" class="form-label">Back Image</label>
                                <% if (card.image_back) { %>
                                <img src="<%= card.image_back %>" class="img-thumbnail mb-2" style="max-height: 150px;">
                                <% } %>
                                <input type="file" class="form-control" id="image_back" name="image_back" accept="image/*">
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a href="/admin/cards" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- eBay Sold Price Research -->
            <div class="card mt-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0"><i class="bi bi-search"></i> eBay Prices</h5>
                        <small class="text-muted">Active listings on eBay AU — fixed price, lowest first</small>
                    </div>
                    <button type="button" class="btn btn-warning btn-sm" id="ebayCheckBtn">
                        <i class="bi bi-graph-up"></i> Check eBay
                    </button>
                </div>
                <div class="card-body" id="ebayResults" style="display:none;">
                    <div id="ebayLoading" class="text-center py-3" style="display:none;">
                        <div class="spinner-border spinner-border-sm text-warning me-2"></div>
                        <span class="text-muted">Searching eBay...</span>
                    </div>
                    <div id="ebayError" class="alert alert-danger" style="display:none;"></div>
                    <div id="ebayContent" style="display:none;">
                        <div id="ebayStats" class="row g-3 mb-4"></div>
                        <p class="text-muted small mb-2">Query: <code id="ebayQuery"></code></p>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:60px;">Image</th>
                                        <th>Title</th>
                                        <th>Price (AUD)</th>
                                        <th>Condition</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="ebayTableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Additional Images Section -->
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">Condition Comparison Images</h5>
                    <small class="text-muted">Add multiple images to show card condition from different angles</small>
                </div>
                <div class="card-body">
                    <!-- Existing Additional Images -->
                    <% if (additionalImages && additionalImages.length > 0) { %>
                    <div class="row mb-4">
                        <% additionalImages.forEach(img => { %>
                        <div class="col-md-3 mb-3">
                            <div class="card">
                                <img src="<%= img.image_url %>" class="card-img-top" alt="Card image">
                                <div class="card-body p-2">
                                    <p class="card-text small mb-2">
                                        <span class="badge bg-secondary"><%= img.image_type %></span>
                                    </p>
                                    <form action="/admin/cards/<%= card.id %>/images/<%= img.id %>/delete" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm w-100"
                                                onclick="return confirm('Delete this image?')">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                    <% } else { %>
                    <p class="text-muted">No additional images yet. Add some below!</p>
                    <% } %>

                    <!-- Add New Images Form -->
                    <form action="/admin/cards/<%= card.id %>/images/add" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="images" class="form-label">Upload Images</label>
                            <input type="file" class="form-control" id="images" name="images"
                                   accept="image/*" multiple>
                            <small class="form-text text-muted">
                                Select up to 10 images. Useful for showing corners, edges, surface details, etc.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Image Type (for all selected images)</label>
                            <select class="form-select" name="image_type_0" id="defaultImageType">
                                <option value="detail">Detail Shot</option>
                                <option value="front">Front</option>
                                <option value="back">Back</option>
                                <option value="edge">Edge View</option>
                                <option value="corner">Corner Detail</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-plus-circle"></i> Add Images
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Parallels & Variations Section -->
    <div class="col-lg-8 offset-lg-2 mt-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">Parallels &amp; Variations</h5>
                    <small class="text-muted">Foil parallels, colour variants, errors, corrections — anything that's a different version of this card</small>
                </div>
                <% if (card.set_name) { %>
                <a href="/admin/set-variations?set_name=<%= encodeURIComponent(card.set_name) %>" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-collection"></i> Bulk add for <%= card.set_name %>
                </a>
                <% } %>
            </div>
            <div class="card-body">
                <% if (variations && variations.length > 0) { %>
                <div class="table-responsive mb-4">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Condition</th>
                                <th>Order</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% variations.forEach(v => { %>
                            <tr>
                                <td>
                                    <% if (v.image_url) { %>
                                    <img src="<%= v.image_url %>" style="height:48px;width:auto;border-radius:4px;">
                                    <% } else { %>
                                    <span class="text-muted small">—</span>
                                    <% } %>
                                </td>
                                <td><strong><%= v.variation_name %></strong></td>
                                <td>$<%= parseFloat(v.price_nzd).toFixed(2) %></td>
                                <td><%= v.quantity %></td>
                                <td><%= v.condition || '—' %></td>
                                <td><%= v.sort_order %></td>
                                <td class="text-end">
                                    <a href="/admin/cards/<%= card.id %>/variations/<%= v.id %>/edit" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form action="/admin/cards/<%= card.id %>/variations/<%= v.id %>/delete" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete <%= v.variation_name %> variation?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <p class="text-muted mb-3">No variations yet.</p>
                <% } %>

                <!-- Add variation form -->
                <h6 class="mb-3">Add Variation</h6>
                <form action="/admin/cards/<%= card.id %>/variations/add" method="POST" enctype="multipart/form-data">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label">Name *</label>
                            <input type="text" class="form-control form-control-sm" name="variation_name" placeholder="e.g. Pink Parallel" required>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Price (NZD)</label>
                            <input type="number" class="form-control form-control-sm" name="price_nzd" step="0.01" min="0" value="0.00">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Qty</label>
                            <input type="number" class="form-control form-control-sm" name="quantity" min="0" value="0">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Condition</label>
                            <select class="form-select form-select-sm" name="condition">
                                <option value="">Any</option>
                                <option value="mint">Mint</option>
                                <option value="near_mint">Near Mint</option>
                                <option value="excellent">Excellent</option>
                                <option value="good">Good</option>
                                <option value="played">Played</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <label class="form-label">Order</label>
                            <input type="number" class="form-control form-control-sm" name="sort_order" value="0" min="0">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Image</label>
                            <input type="file" class="form-control form-control-sm" name="variation_image" accept="image/*">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success btn-sm mt-3">
                        <i class="bi bi-plus-circle"></i> Add Variation
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
// Cascading dropdowns for Manufacturer -> Set Name -> Insert
document.addEventListener('DOMContentLoaded', function() {
    const manufacturerSelect = document.getElementById('manufacturer');
    const setNameSelect = document.getElementById('set_name');
    const insertListSelect = document.getElementById('insert_list');
    const sportTypeSelect = document.getElementById('sport_type');
    const addManufacturerBtn = document.getElementById('addManufacturerBtn');
    const addSetBtn = document.getElementById('addSetBtn');
    const addInsertBtn = document.getElementById('addInsertBtn');
    const addSportTypeBtn = document.getElementById('addSportTypeBtn');

    const currentManufacturer = manufacturerSelect.dataset.current;
    const currentSet = setNameSelect.dataset.current;
    const currentInsert = insertListSelect.dataset.current;
    const currentSportType = sportTypeSelect.dataset.current;
    let currentManufacturerId = null;
    let currentSetId = null;

    // Load manufacturers on page load
    async function loadManufacturers() {
        try {
            const response = await fetch('/admin/api/manufacturers');
            const manufacturers = await response.json();

            manufacturerSelect.innerHTML = '<option value="">Select manufacturer...</option>';
            manufacturers.forEach(m => {
                const option = document.createElement('option');
                option.value = m.name;
                option.dataset.id = m.id;
                option.textContent = m.name;
                if (m.name === currentManufacturer) {
                    option.selected = true;
                    currentManufacturerId = m.id;
                }
                manufacturerSelect.appendChild(option);
            });

            // If we have a current manufacturer, load its sets
            if (currentManufacturerId) {
                await loadSets(currentManufacturerId, currentSet);
            }
        } catch (error) {
            console.error('Error loading manufacturers:', error);
            manufacturerSelect.innerHTML = '<option value="">Error loading manufacturers</option>';
        }
    }

    // Load sets when manufacturer changes
    async function loadSets(manufacturerId, selectSet = null) {
        try {
            setNameSelect.disabled = true;
            setNameSelect.innerHTML = '<option value="">Loading...</option>';

            const response = await fetch(`/admin/api/manufacturers/${manufacturerId}/sets`);
            const sets = await response.json();

            setNameSelect.innerHTML = '<option value="">Select set...</option>';
            sets.forEach(s => {
                const option = document.createElement('option');
                option.value = s.set_name;
                option.dataset.id = s.id;
                option.textContent = s.set_name + (s.year ? ` (${s.year})` : '');
                if (selectSet && s.set_name === selectSet) {
                    option.selected = true;
                    currentSetId = s.id;
                }
                setNameSelect.appendChild(option);
            });

            setNameSelect.disabled = false;
            addSetBtn.disabled = false;

            // If we have a current set, load its inserts
            if (currentSetId) {
                await loadInserts(currentSetId, currentInsert);
            }
        } catch (error) {
            console.error('Error loading sets:', error);
            setNameSelect.innerHTML = '<option value="">Error loading sets</option>';
            setNameSelect.disabled = true;
        }
    }

    // Load inserts when set changes
    async function loadInserts(setId, selectInsert = null) {
        try {
            insertListSelect.disabled = true;
            insertListSelect.innerHTML = '<option value="">Loading...</option>';

            const response = await fetch(`/admin/api/sets/${setId}/inserts`);
            const inserts = await response.json();

            insertListSelect.innerHTML = '<option value="">Base Set (no insert)</option>';
            inserts.forEach(i => {
                const option = document.createElement('option');
                option.value = i.insert_name;
                option.dataset.id = i.id;
                option.textContent = i.insert_name;
                if (selectInsert && i.insert_name === selectInsert) {
                    option.selected = true;
                }
                insertListSelect.appendChild(option);
            });

            insertListSelect.disabled = false;
            addInsertBtn.disabled = false;
        } catch (error) {
            console.error('Error loading inserts:', error);
            insertListSelect.innerHTML = '<option value="">Error loading inserts</option>';
            insertListSelect.disabled = true;
        }
    }

    // Load sport types on page load
    async function loadSportTypes() {
        try {
            const response = await fetch('/admin/api/sport-types');
            const sportTypes = await response.json();

            sportTypeSelect.innerHTML = '<option value="">Select sport/type...</option>';
            sportTypes.forEach(st => {
                const option = document.createElement('option');
                option.value = st.name;
                option.dataset.id = st.id;
                option.textContent = st.name;
                if (st.name === currentSportType) {
                    option.selected = true;
                }
                sportTypeSelect.appendChild(option);
            });
        } catch (error) {
            console.error('Error loading sport types:', error);
            sportTypeSelect.innerHTML = '<option value="">Error loading sport types</option>';
        }
    }

    // Manufacturer change event
    manufacturerSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        currentManufacturerId = selectedOption.dataset.id;

        if (currentManufacturerId) {
            loadSets(currentManufacturerId);
        } else {
            setNameSelect.innerHTML = '<option value="">Select manufacturer first</option>';
            setNameSelect.disabled = true;
            addSetBtn.disabled = true;
        }

        // Reset inserts
        insertListSelect.innerHTML = '<option value="">Select set first</option>';
        insertListSelect.disabled = true;
        addInsertBtn.disabled = true;
        currentSetId = null;
    });

    // Set change event
    setNameSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        currentSetId = selectedOption.dataset.id;

        if (currentSetId) {
            loadInserts(currentSetId);
        } else {
            insertListSelect.innerHTML = '<option value="">Select set first</option>';
            insertListSelect.disabled = true;
            addInsertBtn.disabled = true;
        }
    });

    // Add new manufacturer
    addManufacturerBtn.addEventListener('click', async function() {
        const name = prompt('Enter manufacturer name:');
        if (!name || name.trim() === '') return;

        try {
            const response = await fetch('/admin/api/manufacturers', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: name.trim() })
            });

            const manufacturer = await response.json();

            // Add to dropdown
            const option = document.createElement('option');
            option.value = manufacturer.name;
            option.dataset.id = manufacturer.id;
            option.textContent = manufacturer.name;
            option.selected = true;
            manufacturerSelect.appendChild(option);

            // Trigger change to load sets
            currentManufacturerId = manufacturer.id;
            loadSets(manufacturer.id);
        } catch (error) {
            console.error('Error adding manufacturer:', error);
            alert('Failed to add manufacturer');
        }
    });

    // Add new set
    addSetBtn.addEventListener('click', async function() {
        if (!currentManufacturerId) {
            alert('Please select a manufacturer first');
            return;
        }

        const name = prompt('Enter set name:');
        if (!name || name.trim() === '') return;

        const year = prompt('Enter year (optional):');

        try {
            const response = await fetch('/admin/api/sets', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    manufacturer_id: currentManufacturerId,
                    set_name: name.trim(),
                    year: year ? parseInt(year) : null
                })
            });

            const set = await response.json();

            // Add to dropdown
            const option = document.createElement('option');
            option.value = set.set_name;
            option.dataset.id = set.id;
            option.textContent = set.set_name + (set.year ? ` (${set.year})` : '');
            option.selected = true;
            setNameSelect.appendChild(option);

            // Trigger change to load inserts
            currentSetId = set.id;
            loadInserts(set.id);
        } catch (error) {
            console.error('Error adding set:', error);
            alert('Failed to add set');
        }
    });

    // Add new insert
    addInsertBtn.addEventListener('click', async function() {
        if (!currentSetId) {
            alert('Please select a set first');
            return;
        }

        const name = prompt('Enter insert/subset name (e.g., Master, Double Trouble):');
        if (!name || name.trim() === '') return;

        const description = prompt('Enter description (optional):');

        try {
            const response = await fetch('/admin/api/inserts', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    card_set_id: currentSetId,
                    insert_name: name.trim(),
                    description: description || null
                })
            });

            const insert = await response.json();

            // Add to dropdown
            const option = document.createElement('option');
            option.value = insert.insert_name;
            option.dataset.id = insert.id;
            option.textContent = insert.insert_name;
            option.selected = true;
            insertListSelect.appendChild(option);
        } catch (error) {
            console.error('Error adding insert:', error);
            alert('Failed to add insert');
        }
    });

    // Add new sport type
    addSportTypeBtn.addEventListener('click', async function() {
        const name = prompt('Enter sport/type name:');
        if (!name || name.trim() === '') return;

        try {
            const response = await fetch('/admin/api/sport-types', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: name.trim() })
            });

            const sportType = await response.json();

            // Add to dropdown
            const option = document.createElement('option');
            option.value = sportType.name;
            option.dataset.id = sportType.id;
            option.textContent = sportType.name;
            option.selected = true;
            sportTypeSelect.appendChild(option);
        } catch (error) {
            console.error('Error adding sport type:', error);
            alert('Failed to add sport type');
        }
    });

    // Load players for linking
    const playerSelect = document.getElementById('player_id');
    const currentPlayerId = playerSelect.dataset.current;

    async function loadPlayers(searchTerm) {
        try {
            const url = searchTerm ? `/admin/api/players/search?q=${encodeURIComponent(searchTerm)}` : '/admin/api/players/search?q=';
            const response = await fetch(url);
            const players = await response.json();
            playerSelect.innerHTML = '<option value="">No player linked</option>';
            players.forEach(p => {
                const option = document.createElement('option');
                option.value = p.id;
                option.textContent = p.name;
                if (String(p.id) === String(currentPlayerId)) {
                    option.selected = true;
                }
                playerSelect.appendChild(option);
            });
        } catch (error) {
            console.error('Error loading players:', error);
        }
    }

    let playerSearchTimeout;
    const playerSearchInput = document.createElement('input');
    playerSearchInput.type = 'text';
    playerSearchInput.className = 'form-control form-control-sm mt-1';
    playerSearchInput.placeholder = 'Search players...';
    playerSelect.parentNode.insertBefore(playerSearchInput, playerSelect.querySelector('.text-muted') || playerSelect.nextSibling.nextSibling);
    playerSearchInput.addEventListener('input', function() {
        clearTimeout(playerSearchTimeout);
        playerSearchTimeout = setTimeout(() => loadPlayers(this.value), 300);
    });

    // Load initial player list (loads current player)
    loadPlayers('');

    // Initialize
    loadManufacturers();
    loadSportTypes();
});

// eBay price check (Browse API — active listings on eBay AU)
document.getElementById('ebayCheckBtn').addEventListener('click', async function() {
    const resultsDiv = document.getElementById('ebayResults');
    const loadingDiv = document.getElementById('ebayLoading');
    const errorDiv = document.getElementById('ebayError');
    const contentDiv = document.getElementById('ebayContent');

    resultsDiv.style.display = 'block';
    loadingDiv.style.display = 'block';
    errorDiv.style.display = 'none';
    contentDiv.style.display = 'none';
    this.disabled = true;

    try {
        const response = await fetch('/admin/cards/<%= card.id %>/ebay-check');
        const data = await response.json();

        if (!response.ok) throw new Error(data.error || 'Request failed');

        loadingDiv.style.display = 'none';

        document.getElementById('ebayQuery').textContent = data.query;

        if (data.stats) {
            document.getElementById('ebayStats').innerHTML = `
                <div class="col-sm-3"><div class="border rounded p-2 text-center">
                    <div class="text-muted small">Avg Listed</div>
                    <div class="fw-bold fs-5 text-warning">$${data.stats.avg.toFixed(2)}</div>
                </div></div>
                <div class="col-sm-3"><div class="border rounded p-2 text-center">
                    <div class="text-muted small">Low</div>
                    <div class="fw-bold">$${data.stats.min.toFixed(2)}</div>
                </div></div>
                <div class="col-sm-3"><div class="border rounded p-2 text-center">
                    <div class="text-muted small">High</div>
                    <div class="fw-bold">$${data.stats.max.toFixed(2)}</div>
                </div></div>
                <div class="col-sm-3"><div class="border rounded p-2 text-center">
                    <div class="text-muted small">Listings (AU)</div>
                    <div class="fw-bold">${data.total}</div>
                </div></div>
            `;
        } else {
            document.getElementById('ebayStats').innerHTML = '<div class="col-12"><p class="text-muted mb-0">No listings found for this query.</p></div>';
        }

        const tbody = document.getElementById('ebayTableBody');
        tbody.innerHTML = data.items.length === 0
            ? '<tr><td colspan="5" class="text-muted text-center">No results</td></tr>'
            : data.items.map(item => `
                <tr>
                    <td>${item.image ? `<img src="${item.image}" alt="" style="width:50px;height:50px;object-fit:contain;border-radius:4px;">` : '—'}</td>
                    <td class="small">${item.title}</td>
                    <td class="small fw-semibold">$${item.price.toFixed(2)} ${item.currency}</td>
                    <td class="small">${item.condition || '—'}</td>
                    <td><a href="${item.url}" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm py-0">View</a></td>
                </tr>
            `).join('');

        contentDiv.style.display = 'block';
    } catch (err) {
        loadingDiv.style.display = 'none';
        errorDiv.textContent = err.message;
        errorDiv.style.display = 'block';
    } finally {
        this.disabled = false;
    }
});

// Preview selected images
document.getElementById('images')?.addEventListener('change', function(e) {
    const files = e.target.files;
    if (files.length > 0) {
        console.log(`${files.length} image(s) selected`);
    }
});
</script>

