<%- include('../partials/header') %>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h2 class="mb-4">Edit Accessory</h2>

            <% if (errors && errors.length > 0) { %>
            <div class="alert alert-danger">
                <ul class="mb-0">
                    <% errors.forEach(error => { %>
                    <li><%= error.msg %></li>
                    <% }); %>
                </ul>
            </div>
            <% } %>

            <div class="card">
                <div class="card-body">
                    <form action="/admin/accessories/<%= accessory.id %>/edit" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="product_name" class="form-label">Product Name *</label>
                            <input type="text" class="form-control" id="product_name" name="product_name"
                                   value="<%= accessory.product_name %>" required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="category" class="form-label">Category</label>
                                <select class="form-select" id="category" name="category">
                                    <option value="">Select Category...</option>
                                    <option value="Pages" <%= accessory.category === 'Pages' ? 'selected' : '' %>>Pages</option>
                                    <option value="Albums" <%= accessory.category === 'Albums' ? 'selected' : '' %>>Albums</option>
                                    <option value="Sleeves" <%= accessory.category === 'Sleeves' ? 'selected' : '' %>>Sleeves</option>
                                    <option value="Protectors" <%= accessory.category === 'Protectors' ? 'selected' : '' %>>Protectors</option>
                                    <option value="Boxes" <%= accessory.category === 'Boxes' ? 'selected' : '' %>>Boxes</option>
                                    <option value="Binders" <%= accessory.category === 'Binders' ? 'selected' : '' %>>Binders</option>
                                    <option value="Display Cases" <%= accessory.category === 'Display Cases' ? 'selected' : '' %>>Display Cases</option>
                                    <option value="Storage" <%= accessory.category === 'Storage' ? 'selected' : '' %>>Storage</option>
                                    <option value="Other" <%= accessory.category === 'Other' ? 'selected' : '' %>>Other</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="manufacturer" class="form-label">Manufacturer</label>
                                <input type="text" class="form-control" id="manufacturer" name="manufacturer"
                                       value="<%= accessory.manufacturer || '' %>">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="price_nzd" class="form-label">Price (NZD) *</label>
                                <input type="number" class="form-control" id="price_nzd" name="price_nzd"
                                       step="0.01" min="0" value="<%= accessory.price_nzd %>" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="quantity" class="form-label">Quantity *</label>
                                <input type="number" class="form-control" id="quantity" name="quantity"
                                       min="0" value="<%= accessory.quantity %>" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="3"><%= accessory.description || '' %></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="image" class="form-label">Image</label>
                            <% if (accessory.image_url) { %>
                            <div class="mb-2">
                                <img src="<%= accessory.image_url %>" alt="Current image" style="max-width: 200px;">
                            </div>
                            <% } %>
                            <input type="file" class="form-control" id="image" name="image" accept="image/*">
                            <small class="text-muted">Leave empty to keep current image</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Update Accessory
                            </button>
                            <a href="/admin/accessories" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
