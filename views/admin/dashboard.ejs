<%- include('../partials/header') %>

<div class="container my-4">
    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h3><%= pendingOrdersCount %></h3>
                    <p class="mb-0">Pending Orders</p>
                    <a href="/admin/orders?status=pending" class="btn btn-light mt-3">View Orders</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h3><%= pendingFigurinesCount %></h3>
                    <p class="mb-0">Pending Figurines</p>
                    <a href="/admin/figurines" class="btn btn-light mt-3">Review</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h3><%= newInquiriesCount %></h3>
                    <p class="mb-0">New Inquiries</p>
                    <a href="/admin/inquiries?status=new" class="btn btn-light mt-3">View Inquiries</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h3><%= usersCount %></h3>
                    <p class="mb-0">Registered Users</p>
                    <a href="/admin/users" class="btn btn-light mt-3">Manage Users</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h3><%= typeof openTicketsCount !== 'undefined' ? openTicketsCount : 0 %></h3>
                    <p class="mb-0">Open Tickets</p>
                    <a href="/admin/tickets" class="btn btn-light mt-3">View Tickets</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 bg-light">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-stack text-primary" style="font-size:2rem;"></i>
                    <div>
                        <div class="fw-bold fs-4"><%= totalStock.toLocaleString() %></div>
                        <div class="text-muted small">Cards in stock</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 bg-light">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-currency-dollar text-success" style="font-size:2rem;"></i>
                    <div>
                        <div class="fw-bold fs-4">NZD $<%= Number(totalValue).toLocaleString('en-NZ', { minimumFractionDigits: 2 }) %></div>
                        <div class="text-muted small">Total stock value at sale price</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Quick Actions</h5>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="/admin/cards" class="btn btn-primary">Manage Cards</a>
                        <a href="/admin/cards/add" class="btn btn-primary">Add Card</a>
                        <a href="/admin/scan" class="btn btn-success"><i class="bi bi-camera"></i> Scan Cards</a>
                        <a href="/admin/players" class="btn btn-dark">Manage Players</a>
                        <a href="/admin/players/import" class="btn btn-dark">Import Players</a>
                        <a href="/admin/sets" class="btn btn-info">Manage Sets</a>
                        <a href="/admin/accessories" class="btn btn-success">Manage Accessories</a>
                        <a href="/admin/pending-cards" class="btn btn-warning">
                            <i class="bi bi-inbox"></i> Pending Submissions
                        </a>
                        <a href="/admin/wants" class="btn btn-danger">
                            <i class="bi bi-star-fill"></i> User Wants
                        </a>
                        <a href="/admin/users" class="btn btn-success">Manage Users</a>
                        <a href="/admin/orders" class="btn btn-primary">Manage Orders</a>
                        <a href="/admin/figurines" class="btn btn-primary">Manage Figurines</a>
                        <a href="/admin/inquiries" class="btn btn-primary">Manage Inquiries</a>
                        <a href="/admin/settings" class="btn btn-secondary"><i class="bi bi-gear"></i> Store Settings</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card border-success h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Bulk Import
                    </h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Import hundreds of cards at once from CSV files. Perfect for bulk inventory updates!</p>
                    <ul class="small mb-3">
                        <li>Column mapping support</li>
                        <li>Duplicate detection</li>
                        <li>Preview before importing</li>
                        <li>Import history tracking</li>
                    </ul>
                    <a href="/admin/csv-import" class="btn btn-success">
                        <i class="bi bi-upload"></i> CSV Import
                    </a>
                    <a href="/admin/csv-import/history" class="btn btn-outline-success">
                        <i class="bi bi-clock-history"></i> History
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card border-info h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-check2-square"></i> Unit Testing
                    </h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Run automated tests to ensure all features work correctly after updates.</p>
                    <ul class="small mb-3">
                        <li>35+ automated tests</li>
                        <li>Code coverage reports</li>
                        <li>Integration testing</li>
                        <li>One-click execution</li>
                    </ul>
                    <a href="/admin/tests" class="btn btn-info">
                        <i class="bi bi-lightning"></i> Run Tests
                    </a>
                    <a href="/admin/tests/coverage" target="_blank" class="btn btn-outline-info">
                        <i class="bi bi-graph-up"></i> Coverage
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info">
        <h5 class="alert-heading">
            <i class="bi bi-stars"></i> New Features Available
        </h5>
        <p class="mb-2"><strong>Recently Added:</strong></p>
        <ul class="mb-0">
            <li><strong>Card Parallels & Variations</strong> - Define parallels (Rainbow, Pink Foil, etc.) at the set level and they auto-apply to every card. Manage per-card variations with individual pricing, stock, and photos. <a href="/admin/sets" class="alert-link">Manage Sets</a></li>
            <li><strong>Set Overview</strong> - When editing a set, see a full breakdown of base set sections vs specials/inserts, with card counts per group.</li>
            <li><strong>Variation Picker on Card Pages</strong> - Customers can select a parallel before adding to cart — price and image update live.</li>
            <li><strong>Bulk CSV Import</strong> - Import hundreds of cards at once with duplicate detection. Newly imported cards automatically get set parallels applied. <a href="/admin/csv-import" class="alert-link">CSV Import</a></li>
            <li><strong>Multiple Images</strong> - Add up to 10 condition photos per card with lightbox gallery</li>
            <li><strong>Collection Tracking</strong> - Customers can mark cards (and specific parallels) as Have / Want from the card detail page</li>
            <li><strong>Unit Testing</strong> - Run tests after updates to catch bugs early. <a href="/admin/tests" class="alert-link">Run Tests</a></li>
        </ul>
    </div>
</div>

<%- include('../partials/footer') %>
