<%- include('../partials/header') %>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-inbox"></i> Pending Card Submissions</h2>
        <span class="badge bg-warning text-dark fs-6"><%= pendingCards.length %> pending</span>
    </div>

    <% if (success === 'deleted') { %>
    <div class="alert alert-success alert-dismissible fade show">Card deleted from queue. <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>
    <% if (error === 'not_found') { %>
    <div class="alert alert-danger alert-dismissible fade show">Card not found. <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>

    <% if (pendingCards.length === 0) { %>
    <div class="alert alert-info">
        <i class="bi bi-check-circle"></i> No pending submissions — queue is clear.
    </div>
    <% } else { %>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Card</th>
                        <th>Set / Year</th>
                        <th>Category</th>
                        <th>Submitted By</th>
                        <th>Collectors</th>
                        <th>Photo</th>
                        <th>Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                <% pendingCards.forEach(card => { %>
                <tr>
                    <td>
                        <div class="fw-semibold"><%= card.card_name %></div>
                        <% if (card.manufacturer) { %><small class="text-muted"><%= card.manufacturer %></small><% } %>
                        <% if (card.card_number) { %><small class="text-muted"> · #<%= card.card_number %></small><% } %>
                    </td>
                    <td>
                        <%= card.set_name || '—' %>
                        <% if (card.year) { %><br><small class="text-muted"><%= card.year %></small><% } %>
                    </td>
                    <td>
                        <span class="badge <%= card.card_category === 'sport' ? 'bg-success' : 'bg-secondary' %>">
                            <%= card.card_category === 'sport' ? 'Sport' : 'Non-Sport' %>
                        </span>
                        <% if (card.sport_type) { %><br><small><%= card.sport_type %></small><% } %>
                    </td>
                    <td><small><%= card.submitted_by_username || 'Unknown' %></small></td>
                    <td>
                        <span class="badge bg-primary"><%= card.collection_count %></span>
                    </td>
                    <td>
                        <% if (card.image_front) { %>
                        <img src="<%= card.image_front %>" height="40" style="object-fit:contain">
                        <% } else { %>
                        <span class="text-muted">—</span>
                        <% } %>
                    </td>
                    <td><small class="text-muted"><%= new Date(card.created_at).toLocaleDateString('en-NZ') %></small></td>
                    <td>
                        <a href="/admin/pending-cards/<%= card.id %>/edit" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i> Edit / Promote
                        </a>
                    </td>
                </tr>
                <% }); %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
