<%- include('../partials/header') %>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Match Players to Cards</h2>
                <a href="/admin/players" class="btn btn-outline-secondary">Back to Players</a>
            </div>

            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> This wizard automatically finds cards that match each player's name.
                Review the matches below, tick the ones you want to link, then click "Apply Matches".
            </div>

            <% if (matches && matches.length > 0) { %>
            <form action="/admin/players/match" method="POST">
                <% matches.forEach(match => { %>
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong><%= match.player.name %></strong>
                        <span class="badge bg-primary"><%= match.cards.length %> potential match<%= match.cards.length !== 1 ? 'es' : '' %></span>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 40px;">
                                            <input type="checkbox" class="form-check-input select-all"
                                                   data-player="<%= match.player.id %>">
                                        </th>
                                        <th>Card Name</th>
                                        <th>Set</th>
                                        <th>#</th>
                                        <th>Manufacturer</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% match.cards.forEach(card => { %>
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input card-check-<%= match.player.id %>"
                                                   name="player_<%= match.player.id %>" value="<%= card.id %>" checked>
                                        </td>
                                        <td><%= card.card_name %></td>
                                        <td><%= card.set_name || '-' %></td>
                                        <td><%= card.card_number || '-' %></td>
                                        <td><%= card.manufacturer || '-' %></td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <% }); %>

                <div class="d-flex gap-2 mb-4">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-link-45deg"></i> Apply Matches
                    </button>
                    <a href="/admin/players" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
            <% } else { %>
            <div class="alert alert-warning">
                <i class="bi bi-check-circle"></i> No unlinked matches found. Either all players are already linked to their cards, or no matching card names were found.
            </div>
            <% } %>
        </div>
    </div>
</div>

<script>
// Select all toggle per player
document.querySelectorAll('.select-all').forEach(function(checkbox) {
    checkbox.addEventListener('change', function() {
        const playerId = this.dataset.player;
        document.querySelectorAll('.card-check-' + playerId).forEach(function(cb) {
            cb.checked = checkbox.checked;
        });
    });
});
</script>

<%- include('../partials/footer') %>
