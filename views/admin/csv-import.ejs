<%- include('../partials/header') %>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Bulk CSV Import</h2>
                <div>
                    <a href="/admin/csv-import/template" class="btn btn-outline-primary me-2">
                        <i class="bi bi-download"></i> Download Template
                    </a>
                    <a href="/admin/csv-import/history" class="btn btn-outline-secondary">
                        <i class="bi bi-clock-history"></i> Import History
                    </a>
                </div>
            </div>

            <% if (errors && errors.length > 0) { %>
            <div class="alert alert-danger">
                <ul class="mb-0">
                    <% errors.forEach(error => { %>
                    <li><%= error.msg %></li>
                    <% }); %>
                </ul>
            </div>
            <% } %>

            <% if (errorMessage) { %>
            <div class="alert alert-danger"><%= errorMessage %></div>
            <% } %>

            <div class="alert alert-info">
                <h5 class="alert-heading">How Bulk Import Works</h5>
                <ol>
                    <li>Download the CSV template or prepare your own CSV file</li>
                    <li>Fill in your card data — <strong>card_name, card_category, price_nzd</strong> are required</li>
                    <li>Upload the CSV file and map columns if needed</li>
                    <li>Preview the data and choose how to handle duplicates</li>
                    <li>Execute the import — cards will be added to inventory!</li>
                </ol>
                <hr>
                <h6>Auto-creation</h6>
                <ul class="mb-0">
                    <li><strong>Manufacturers</strong> — new manufacturers are automatically created if they don't exist</li>
                    <li><strong>Sets</strong> — new sets are automatically created under the manufacturer</li>
                    <li><strong>Sport/Types</strong> — new sport types (e.g. Rugby, Cricket) are automatically added</li>
                    <li><strong>Inserts</strong> — new insert/subset names are automatically created under the set</li>
                    <li><strong>Duplicates</strong> — matched on card_name + set_name + card_number. You choose to skip, update, or merge quantity</li>
                </ul>
            </div>

            <div class="card">
                <div class="card-body">
                    <form action="/admin/csv-import/upload" method="POST" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label for="csv_file" class="form-label">
                                <h5>Step 1: Select CSV File</h5>
                            </label>
                            <input type="file" class="form-control" id="csv_file" name="csv_file" accept=".csv,.txt" required>
                            <div class="form-text">Maximum file size: 10MB. Accepted formats: .csv, .txt</div>
                        </div>

                        <hr>

                        <div class="mb-4">
                            <h5 class="mb-3">Step 2: Map CSV Columns (Optional)</h5>
                            <p class="text-muted">If your CSV uses different column names, map them to our database fields:</p>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Card Name Column <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="col_card_name"
                                           placeholder="card_name" value="card_name">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Manufacturer Column</label>
                                    <input type="text" class="form-control" name="col_manufacturer"
                                           placeholder="manufacturer" value="manufacturer">
                                    <small class="text-muted">Auto-created if new</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Set Name Column</label>
                                    <input type="text" class="form-control" name="col_set_name"
                                           placeholder="set_name" value="set_name">
                                    <small class="text-muted">Auto-created if new</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Insert/Subset Column</label>
                                    <input type="text" class="form-control" name="col_insert_list"
                                           placeholder="insert_list" value="insert_list">
                                    <small class="text-muted">e.g., Base Set, Master, Double Trouble. Auto-created if new</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Card Number Column</label>
                                    <input type="text" class="form-control" name="col_card_number"
                                           placeholder="card_number" value="card_number">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Year Column</label>
                                    <input type="text" class="form-control" name="col_year"
                                           placeholder="year" value="year">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Category Column <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="col_card_category"
                                           placeholder="card_category" value="card_category">
                                    <small class="text-muted">sport or non_sport</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Sport/Type Column</label>
                                    <input type="text" class="form-control" name="col_sport_type"
                                           placeholder="sport_type" value="sport_type">
                                    <small class="text-muted">e.g., Rugby, Cricket, Pokemon. Auto-created if new</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Condition Column</label>
                                    <input type="text" class="form-control" name="col_condition"
                                           placeholder="condition" value="condition">
                                    <small class="text-muted">mint, near_mint, excellent, good, played</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Price (NZD) Column <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="col_price_nzd"
                                           placeholder="price_nzd" value="price_nzd">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Quantity Column</label>
                                    <input type="text" class="form-control" name="col_quantity"
                                           placeholder="quantity" value="quantity">
                                    <small class="text-muted">Defaults to 1 if not provided</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Product Type Column</label>
                                    <input type="text" class="form-control" name="col_product_type"
                                           placeholder="product_type" value="product_type">
                                    <small class="text-muted">single, pack, or box. Defaults to single</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Team Column</label>
                                    <input type="text" class="form-control" name="col_team"
                                           placeholder="team" value="team">
                                    <small class="text-muted">e.g., All Blacks, Warriors, Black Caps</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Variation Column</label>
                                    <input type="text" class="form-control" name="col_variation"
                                           placeholder="variation" value="variation">
                                    <small class="text-muted">Error, Correction, UER, Short Print, Other</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Rookie Card Column</label>
                                    <input type="text" class="form-control" name="col_is_rookie_card"
                                           placeholder="is_rookie_card" value="is_rookie_card">
                                    <small class="text-muted">yes/no or true/false</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Notes Column</label>
                                    <input type="text" class="form-control" name="col_notes"
                                           placeholder="notes" value="notes">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Description Column</label>
                                    <input type="text" class="form-control" name="col_description"
                                           placeholder="description" value="description">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Image Front Column</label>
                                    <input type="text" class="form-control" name="col_image_front"
                                           placeholder="image_front" value="image_front">
                                    <small class="text-muted">URL or path to front image</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Image Back Column</label>
                                    <input type="text" class="form-control" name="col_image_back"
                                           placeholder="image_back" value="image_back">
                                    <small class="text-muted">URL or path to back image</small>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-upload"></i> Upload and Preview
                            </button>
                            <a href="/admin/cards" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">CSV Format Example</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-2">Fields marked with <span class="text-danger">*</span> are required. New manufacturers, sets, sport types, and inserts are automatically created.</p>
                    <pre class="bg-light p-3 rounded" style="font-size: 0.75rem; overflow-x: auto;"><code>card_name*,manufacturer,set_name,insert_list,card_number,year,card_category*,sport_type,condition,price_nzd*,quantity,product_type,team,variation,is_rookie_card,notes,description
Beauden Barrett,Tap N Play,2024 All Blacks,Base Set,10,2024,sport,Rugby,mint,5.00,4,single,All Blacks,,,,"All Blacks first five-eighth"
"Shaun Johnson Rookie",Select,2012 NRL,Base Set,99,2012,sport,Rugby League,near_mint,25.00,1,single,Warriors,,yes,,Rookie card
"2024 All Blacks Box",Tap N Play,2024 All Blacks,,,2024,sport,Rugby,mint,89.99,2,box,,,,Sealed box,36 packs per box
Pikachu,Wizards of the Coast,Base Set,,58,1999,non_sport,Pokemon,mint,45.00,3,single,,,,,"Original base set"</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
