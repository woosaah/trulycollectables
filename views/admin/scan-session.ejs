<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Scan: <%= sessionTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css">
    <style>
        body { background: #111; color: #fff; min-height: 100dvh; display: flex; flex-direction: column; }
        #card-area { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem; }
        #card-number { font-size: 3.5rem; font-weight: 700; line-height: 1; }
        #card-name { font-size: 1.1rem; color: #aaa; margin-top: 0.25rem; }
        #existing-img { max-width: 140px; max-height: 140px; object-fit: contain; border-radius: 8px; border: 2px solid #444; }
        #capture-btn {
            display: flex; align-items: center; justify-content: center;
            width: 100%; max-width: 380px; height: 80px; font-size: 1.3rem;
            background: #198754; border: none; border-radius: 16px; color: #fff;
            cursor: pointer; user-select: none; touch-action: manipulation;
        }
        #capture-btn:active { background: #146c43; transform: scale(0.97); }
        #skip-btn {
            width: 100%; max-width: 380px; height: 56px; font-size: 1rem;
            background: transparent; border: 2px solid #555; color: #aaa; border-radius: 12px;
            touch-action: manipulation;
        }
        #skip-btn:active { background: #222; }
        #status-bar { background: #1a1a1a; padding: 0.75rem 1.5rem; }
        #progress-bar-inner { transition: width 0.3s ease; }
        .done-state { text-align: center; padding: 3rem 1rem; }
        .uploading-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.7);
            display: flex; align-items: center; justify-content: center;
            z-index: 100; flex-direction: column; gap: 1rem; font-size: 1.2rem;
        }
        .has-image-badge { font-size: 0.75rem; color: #198754; }
        #crop-modal {
            position: fixed; inset: 0; background: #000; z-index: 200;
            flex-direction: column; display: none;
        }
        #crop-modal .crop-view { flex: 1; overflow: hidden; min-height: 0; }
        #crop-modal .crop-actions {
            padding: 0.75rem; display: flex; gap: 0.75rem; background: #1a1a1a;
        }
        #crop-modal .btn-retake {
            flex: 1; height: 56px; background: transparent; border: 2px solid #555;
            color: #aaa; border-radius: 12px; font-size: 1rem; touch-action: manipulation;
        }
        #crop-modal .btn-use {
            flex: 2; height: 64px; background: #198754; border: none;
            border-radius: 12px; font-size: 1.2rem; color: #fff; font-weight: 600;
            touch-action: manipulation;
        }
        #crop-modal .btn-retake:active { background: #222; }
        #crop-modal .btn-use:active { background: #146c43; transform: scale(0.97); }
        #jump-bar { background: #161616; padding: 0.5rem 1rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
        #jump-input {
            width: 90px; background: #222; border: 1px solid #444; color: #fff;
            border-radius: 8px; padding: 0.4rem 0.6rem; font-size: 1rem; text-align: center;
        }
        #jump-btn {
            background: #0d6efd; border: none; border-radius: 8px; color: #fff;
            padding: 0.4rem 1rem; font-size: 1rem; touch-action: manipulation;
        }
        #jump-btn:active { background: #0b5ed7; }
    </style>
</head>
<body>

<!-- Status bar -->
<div id="status-bar">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <a href="/admin/scan" class="text-muted text-decoration-none small">
            <i class="bi bi-arrow-left"></i> <%= sessionTitle %>
        </a>
        <span id="progress-text" class="small text-muted"></span>
    </div>
    <div class="progress" style="height:4px;background:#333;">
        <div id="progress-bar-inner" class="progress-bar bg-success" style="width:0%"></div>
    </div>
</div>

<!-- Card area -->
<div id="card-area">
    <!-- populated by JS -->
</div>

<!-- Jump to card number or player name -->
<div id="jump-bar">
    <span style="font-size:0.85rem;color:#666;">Jump to</span>
    <input type="text" id="jump-input" inputmode="text" placeholder="# or name" style="width:120px;">
    <button type="button" id="jump-btn"><i class="bi bi-arrow-right"></i> Go</button>
</div>

<!-- Bottom controls -->
<div class="p-3 d-flex flex-column align-items-center gap-3" style="background:#1a1a1a;">
    <label for="camera-input" id="capture-btn">
        <i class="bi bi-camera-fill me-2"></i>Capture
    </label>
    <button id="skip-btn" onclick="skip()">
        Skip &rarr;
    </button>
</div>

<!-- Hidden camera input -->
<input type="file" id="camera-input" accept="image/*" capture="environment" style="display:none">

<!-- Crop modal -->
<div id="crop-modal">
    <div class="crop-view">
        <img id="crop-img" src="" style="display:block; max-width:100%;">
    </div>
    <div class="crop-actions">
        <button type="button" class="btn-retake" id="btn-retake">Retake</button>
        <button type="button" class="btn-use" id="btn-use"><i class="bi bi-check-lg me-1"></i>Use Photo</button>
    </div>
</div>

<!-- Uploading overlay -->
<div class="uploading-overlay" id="uploading" style="display:none;">
    <div class="spinner-border text-light" style="width:3rem;height:3rem;"></div>
    <span>Saving...</span>
</div>

<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
<script>
window.onerror = function(msg, src, line) {
    document.body.insertAdjacentHTML('afterbegin',
        '<div style="background:red;color:#fff;padding:1rem;position:fixed;top:0;left:0;right:0;z-index:9999;font-size:0.9rem;">JS Error: ' + msg + ' (line ' + line + ')</div>');
};

const cards = <%- JSON.stringify(cards) %>;
const csrfToken = '<%= csrfToken %>';
let index = 0;
let scanned = 0;
let cropper = null;

const cardArea = document.getElementById('card-area');
const progressText = document.getElementById('progress-text');
const progressBar = document.getElementById('progress-bar-inner');
const captureBtn = document.getElementById('capture-btn');
const skipBtn = document.getElementById('skip-btn');
const cameraInput = document.getElementById('camera-input');
const uploading = document.getElementById('uploading');
const cropModal = document.getElementById('crop-modal');
const cropImg = document.getElementById('crop-img');
const jumpInput = document.getElementById('jump-input');

function setControlsDisabled(val) {
    skipBtn.disabled = val;
    // label can't be disabled — toggle pointer-events instead
    captureBtn.style.pointerEvents = val ? 'none' : '';
}

function render() {
    if (index >= cards.length) {
        showDone();
        return;
    }

    const card = cards[index];
    const pct = Math.round(index / cards.length * 100);
    progressText.textContent = `${index + 1} of ${cards.length}`;
    progressBar.style.width = pct + '%';

    const hasImage = !!card.image_front;
    const showSet = <%- JSON.stringify(showSetName) %>;

    cardArea.innerHTML = `
        <div class="text-center">
            ${hasImage ? `
                <img src="${card.image_front}" id="existing-img" class="mb-3">
                <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                    <span class="has-image-badge"><i class="bi bi-check-circle-fill"></i> Has image</span>
                    <button type="button" data-action="delete-image" data-card-id="${card.id}"
                        style="background:#dc3545;border:none;border-radius:8px;color:#fff;font-size:0.75rem;padding:0.2rem 0.6rem;touch-action:manipulation;">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            ` : ''}
            ${showSet && card.set_name ? `<div style="font-size:0.85rem;color:#888;margin-bottom:0.25rem;">${card.set_name}</div>` : ''}
            <div id="card-number">${card.card_number || '—'}</div>
            <div id="card-name">${card.card_name}</div>
        </div>
    `;

    captureBtn.style.display = '';
    skipBtn.style.display = '';
}

function jumpToCard() {
    const input = document.getElementById('jump-input');
    const val = (input.value || '').trim();
    if (!val) { alert('Enter a card number or player name'); return; }

    const q = val.toLowerCase();
    const target = cards.findIndex(c => {
        const cn = String(c.card_number);
        if (cn.toLowerCase() === q) return true;
        if (!isNaN(val) && !isNaN(cn)) return parseInt(cn) === parseInt(val);
        if (c.card_name && c.card_name.toLowerCase().includes(q)) return true;
        return false;
    });

    if (target === -1) {
        alert('"' + val + '" not found in this session');
        return;
    }

    index = target;
    input.value = '';
    input.blur();
    render();

    // flash the card area so it's obvious something changed
    cardArea.style.opacity = '0.3';
    setTimeout(() => { cardArea.style.opacity = '1'; }, 150);
}

jumpInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') jumpToCard();
});

cardArea.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-action="delete-image"]');
    if (btn) deleteImage(btn.dataset.cardId);
});

async function deleteImage(cardId) {
    if (!confirm('Remove image from this card?')) return;
    try {
        const res = await fetch('/admin/scan/delete-image', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ card_id: cardId })
        });
        const data = await res.json();
        if (data.success) {
            cards[index].image_front = null;
            render();
        } else {
            alert('Failed: ' + (data.error || 'unknown'));
        }
    } catch (err) {
        alert('Error: ' + err.message);
    }
}

document.getElementById('capture-btn').addEventListener('click', () => {
    cameraInput.value = '';
});
document.getElementById('btn-retake').addEventListener('click', cancelCrop);
document.getElementById('btn-use').addEventListener('click', confirmCrop);
document.getElementById('jump-btn').addEventListener('click', jumpToCard);

cameraInput.addEventListener('change', () => {
    const file = cameraInput.files[0];
    if (!file) return;
    const url = URL.createObjectURL(file);
    cropImg.src = url;
    cropModal.style.display = 'flex';
    if (cropper) cropper.destroy();
    cropper = new Cropper(cropImg, {
        viewMode: 1,
        dragMode: 'move',
        autoCropArea: 1,
        guides: false,
        center: false,
        highlight: false,
        toggleDragModeOnDblclick: false,
        checkOrientation: false,
        ready() { URL.revokeObjectURL(url); }
    });
});

function cancelCrop() {
    if (cropper) { cropper.destroy(); cropper = null; }
    cropModal.style.display = 'none';
    cameraInput.value = '';
}

async function confirmCrop() {
    let canvas;
    try {
        canvas = cropper.getCroppedCanvas({ maxWidth: 1400, maxHeight: 1400 });
    } catch (e) {
        alert('Could not process image — please retake.');
        return;
    }
    if (!canvas) {
        alert('Could not process image — please retake.');
        return;
    }

    const card = cards[index];
    cropModal.style.display = 'none';
    uploading.style.display = 'flex';
    setControlsDisabled(true);

    if (cropper) { cropper.destroy(); cropper = null; }

    canvas.toBlob(async (blob) => {
        try {
            if (!blob) throw new Error('Image conversion failed');
            const form = new FormData();
            form.append('card_id', card.id);
            form.append('image', blob, 'card.jpg');
            form.append('_csrf', csrfToken);

            const res = await fetch('/admin/scan/upload', { method: 'POST', body: form });
            const data = await res.json();

            if (data.success) {
                cards[index].image_front = data.image_path;
                scanned++;
                advance();
            } else {
                alert('Upload failed: ' + (data.error || 'unknown error'));
            }
        } catch (err) {
            alert('Error: ' + err.message);
        } finally {
            uploading.style.display = 'none';
            setControlsDisabled(false);
        }
    }, 'image/jpeg', 0.88);
}

function skip() {
    advance();
}

function advance() {
    index++;
    render();
}

function showDone() {
    captureBtn.style.display = 'none';
    skipBtn.style.display = 'none';
    document.getElementById('jump-bar').style.display = 'none';
    progressText.textContent = `${cards.length} of ${cards.length}`;
    progressBar.style.width = '100%';
    cardArea.innerHTML = `
        <div class="done-state">
            <div style="font-size:4rem;">✓</div>
            <h3 class="mt-3">All done</h3>
            <p class="text-muted">${scanned} photo${scanned !== 1 ? 's' : ''} captured</p>
            <a href="/admin/scan" class="btn btn-outline-light mt-2">Back to Sets</a>
            <a href="/admin/cards" class="btn btn-primary mt-2 ms-2">View Cards</a>
        </div>
    `;
}

render();
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
