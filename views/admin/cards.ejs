<%- include('../partials/header') %>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Cards</h2>
        <a href="/admin/cards/add" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Card
        </a>
    </div>

    <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> Card <%= success %>!
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form action="/admin/cards" method="GET" class="row g-3">
                <div class="col-md-3">
                    <input type="text" class="form-control" name="search" value="<%= filters.search || '' %>" placeholder="Search cards...">
                </div>
                <div class="col-md-2">
                    <select class="form-select" name="card_category">
                        <option value="">All Categories</option>
                        <option value="sport" <%= filters.card_category === 'sport' ? 'selected' : '' %>>Sport</option>
                        <option value="non_sport" <%= filters.card_category === 'non_sport' ? 'selected' : '' %>>Non-Sport</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" name="sport_type">
                        <option value="">All Types</option>
                        <% sportTypes.forEach(sport => { %>
                        <option value="<%= sport %>" <%= filters.sport_type === sport ? 'selected' : '' %>><%= sport %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="set_name">
                        <option value="">All Sets</option>
                        <% setNames.forEach(set => { %>
                        <option value="<%= set %>" <%= filters.set_name === set ? 'selected' : '' %>><%= set %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" name="limit">
                        <% allowedLimits.forEach(function(n) { %>
                        <option value="<%= n %>" <%= limit === n ? "selected" : "" %>><%= n %> per page</option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <% if (cards && cards.length > 0) { %>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Card</th>
                    <th>#</th>
                    <th>Set</th>
                    <th class="d-none d-xl-table-cell">Category</th>
                    <th class="d-none d-xl-table-cell">Type</th>
                    <th>Condition</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Available</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% cards.forEach(card => { %>
                <tr>
                    <td><strong><%= card.card_name %></strong></td>
                    <td><%= card.card_number || '-' %></td>
                    <td><%= card.set_name || '-' %></td>
                    <td class="d-none d-xl-table-cell">
                        <% if (card.card_category === 'sport') { %>
                        <span class="badge bg-primary">Sport</span>
                        <% } else if (card.card_category === 'non_sport') { %>
                        <span class="badge bg-info">Non-Sport</span>
                        <% } else { %>
                        -
                        <% } %>
                    </td>
                    <td class="d-none d-xl-table-cell"><%= card.sport_type || '-' %></td>
                    <td>
                        <% if (card.condition) { %>
                        <span class="badge badge-<%= card.condition.toLowerCase().replace(/[^a-z]/g, '') %>">
                            <%= card.condition %>
                        </span>
                        <% } %>
                    </td>
                    <td><%= card.price_nzd ? '$' + parseFloat(card.price_nzd).toFixed(2) : 'TBC' %></td>
                    <td>
                        <form action="/admin/cards/<%= card.id %>/update-quantity" method="POST" class="d-flex align-items-center gap-1" style="min-width:90px">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="return_to" value="<%= currentUrl %>">
                            <input type="number" name="quantity" value="<%= card.quantity %>" min="0" class="form-control form-control-sm" style="width:60px">
                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Save">&#10003;</button>
                        </form>
                    </td>
                    <td>
                        <form action="/admin/cards/<%= card.id %>/toggle-availability" method="POST" class="d-inline">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="return_to" value="<%= currentUrl %>">
                            <button type="submit" class="btn btn-sm <%= card.available ? 'btn-success' : 'btn-secondary' %>">
                                <%= card.available ? 'Yes' : 'No' %>
                            </button>
                        </form>
                    </td>
                    <td>
                        <a href="/admin/cards/<%= card.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form action="/admin/cards/<%= card.id %>/delete" method="POST" class="d-inline">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirmDelete('Delete this card?')">Delete</button>
                        </form>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <% if (totalPages > 1) { %>
    <nav>
        <ul class="pagination">
            <% for (let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %><%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %><%= filters.card_category ? '&card_category=' + encodeURIComponent(filters.card_category) : '' %><%= filters.sport_type ? '&sport_type=' + encodeURIComponent(filters.sport_type) : '' %><%= filters.set_name ? '&set_name=' + encodeURIComponent(filters.set_name) : '' %>&limit=<%= limit %>&sort=<%= filters.sort %>&order=<%= filters.order %>"><%= i %></a>
            </li>
            <% } %>
        </ul>
    </nav>
    <% } %>
    <% } else { %>
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No cards found.
    </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
