<%- include('../partials/header') %>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h2 class="mb-4">Player Import Complete</h2>

            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card text-center border-success">
                        <div class="card-body">
                            <h3 class="text-success"><%= result.successful %></h3>
                            <p class="mb-0">Imported/Updated</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-center border-danger">
                        <div class="card-body">
                            <h3 class="text-danger"><%= result.failed %></h3>
                            <p class="mb-0">Failed</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-center">
                        <div class="card-body">
                            <h3><%= result.totalRows %></h3>
                            <p class="mb-0">Total Rows</p>
                        </div>
                    </div>
                </div>
            </div>

            <% if (result.errors && result.errors.length > 0) { %>
            <div class="card mb-4 border-danger">
                <div class="card-header bg-danger text-white">Errors</div>
                <div class="card-body">
                    <% result.errors.forEach(err => { %>
                    <p class="mb-1"><strong><%= err.name %>:</strong> <%= err.error %></p>
                    <% }); %>
                </div>
            </div>
            <% } %>

            <div class="alert alert-info">
                <strong>Next step:</strong> Use the <a href="/admin/players/match">matching wizard</a> to link these players to their cards.
            </div>

            <div class="d-flex gap-2">
                <a href="/admin/players" class="btn btn-primary">View Players</a>
                <a href="/admin/players/match" class="btn btn-info">Match to Cards</a>
                <a href="/admin/players/import" class="btn btn-outline-secondary">Import More</a>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
