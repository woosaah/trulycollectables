<%- include('../partials/header') %>

<div class="container my-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/user/dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/user/orders">Orders</a></li>
            <li class="breadcrumb-item active"><%= order.order_number %></li>
        </ol>
    </nav>

    <% if (success) { %>
    <div class="alert alert-success fade show">
        <h5 class="alert-heading"><i class="bi bi-check-circle-fill"></i> Order Placed Successfully!</h5>
        <p>Order <strong>#<%= order.order_number %></strong> has been submitted. A confirmation email has been sent to <strong><%= order.customer_email %></strong>.</p>
        <hr>
        <% if (bankDetails && bankDetails.accountNumber) { %>
        <h6><i class="bi bi-bank"></i> Payment — Bank Transfer</h6>
        <p class="mb-1">Please make payment to the following account:</p>
        <div class="card bg-light mb-2">
            <div class="card-body py-2">
                <% if (bankDetails.bankName) { %>
                <p class="mb-1"><strong>Bank:</strong> <%= bankDetails.bankName %></p>
                <% } %>
                <% if (bankDetails.accountName) { %>
                <p class="mb-1"><strong>Account Name:</strong> <%= bankDetails.accountName %></p>
                <% } %>
                <p class="mb-1"><strong>Account Number:</strong> <code style="font-size: 1.1rem;"><%= bankDetails.accountNumber %></code></p>
                <p class="mb-1"><strong>Amount:</strong> <code style="font-size: 1.1rem;">$<%= parseFloat(order.total_nzd).toFixed(2) %> NZD</code></p>
                <p class="mb-0"><strong>Reference:</strong> <code style="font-size: 1.1rem;"><%= order.order_number %></code></p>
            </div>
        </div>
        <% if (bankDetails.referenceInstructions) { %>
        <p class="mb-0 small text-muted"><i class="bi bi-info-circle"></i> <%= bankDetails.referenceInstructions %></p>
        <% } %>
        <% } else { %>
        <p class="mb-0">We'll be in touch at <strong><%= order.customer_email %></strong> with payment details shortly.</p>
        <% } %>
    </div>
    <% } %>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Order #<%= order.order_number %></h5>
                        <span class="badge badge-<%= order.status %>"><%= order.status.replace(/_/g, ' ').toUpperCase() %></span>
                    </div>
                    <p class="text-muted">Placed on <%= new Date(order.created_at).toLocaleString('en-NZ', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>

                    <h6 class="mt-3 mb-3">Order Items</h6>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% orderItems.forEach(item => { %>
                                <tr>
                                    <td>
                                        <%= item.card_name || item.figurine_name || item.accessory_name %>
                                        <% if (item.variant_label) { %>
                                        <br><small class="text-muted"><%= item.variant_label %></small>
                                        <% } %>
                                        <% if (item.set_name) { %>
                                        <br><small class="text-muted"><%= item.set_name %></small>
                                        <% } %>
                                        <% if (item.accessory_category) { %>
                                        <br><small class="text-muted"><%= item.accessory_category %></small>
                                        <% } %>
                                    </td>
                                    <td>NZD $<%= parseFloat(item.price_nzd).toFixed(2) %></td>
                                    <td><%= item.quantity %></td>
                                    <td>NZD $<%= (parseFloat(item.price_nzd) * item.quantity).toFixed(2) %></td>
                                </tr>
                                <% }); %>
                            </tbody>
                            <tfoot>
                                <% if (parseFloat(order.discount_amount || 0) > 0) { %>
                                <tr>
                                    <td colspan="3" class="text-end text-muted">Subtotal</td>
                                    <td>$<%= parseFloat(order.subtotal_nzd).toFixed(2) %></td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end text-success">Discount</td>
                                    <td class="text-success">-$<%= parseFloat(order.discount_amount).toFixed(2) %></td>
                                </tr>
                                <% } %>
                                <% if (parseFloat(order.shipping_cost || 0) > 0) { %>
                                <tr>
                                    <td colspan="3" class="text-end text-muted">Shipping</td>
                                    <td>$<%= parseFloat(order.shipping_cost).toFixed(2) %></td>
                                </tr>
                                <% } %>
                                <tr>
                                    <th colspan="3" class="text-end">Total (NZD):</th>
                                    <th>$<%= parseFloat(order.total_nzd).toFixed(2) %></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-title">Customer Information</h6>
                    <p class="mb-1"><strong>Name:</strong> <%= order.customer_name %></p>
                    <p class="mb-1"><strong>Email:</strong> <%= order.customer_email %></p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-title">Shipping</h6>
                    <% if (order.shipping_method === 'pickup') { %>
                    <p class="mb-1"><span class="badge bg-info">Local Pickup</span></p>
                    <% } else if (order.shipping_method && order.shipping_method !== 'tbc') { %>
                    <p class="mb-1"><span class="badge bg-secondary"><%= order.shipping_method.charAt(0).toUpperCase() + order.shipping_method.slice(1) %> Bag</span></p>
                    <% } %>
                    <p class="mb-0"><%= order.shipping_address %></p>
                </div>
            </div>

            <% if (order.status === 'pending' && bankDetails && bankDetails.accountNumber && !success) { %>
            <!-- Bank Transfer Details -->
            <div class="card mb-3 border-warning">
                <div class="card-header bg-warning bg-opacity-10">
                    <h6 class="mb-0"><i class="bi bi-bank"></i> Payment Details</h6>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">Please transfer to:</p>
                    <% if (bankDetails.bankName) { %>
                    <p class="mb-1"><strong>Bank:</strong> <%= bankDetails.bankName %></p>
                    <% } %>
                    <% if (bankDetails.accountName) { %>
                    <p class="mb-1"><strong>Account:</strong> <%= bankDetails.accountName %></p>
                    <% } %>
                    <p class="mb-1"><strong>Number:</strong> <code><%= bankDetails.accountNumber %></code></p>
                    <p class="mb-1"><strong>Amount:</strong> <code>$<%= parseFloat(order.total_nzd).toFixed(2) %></code></p>
                    <p class="mb-0"><strong>Reference:</strong> <code><%= order.order_number %></code></p>
                </div>
            </div>
            <% } %>

            <!-- Order Status -->
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-title">Order Status</h6>
                    <span class="badge badge-<%= order.status %>" style="font-size: 0.9rem; padding: 6px 12px;">
                        <%= order.status.replace(/_/g, ' ').toUpperCase() %>
                    </span>
                    <p class="text-muted mt-2 mb-0" style="font-size: 0.85rem;">
                        <% if (order.status === 'pending') { %>
                            Your order has been received. We'll be in touch with payment details shortly.
                        <% } else if (order.status === 'processing') { %>
                            Payment received — we're preparing your order.
                        <% } else if (order.status === 'shipped') { %>
                            Your order is on its way!
                        <% } else if (order.status === 'ready_for_pickup') { %>
                            Your order is ready for pickup.
                        <% } else if (order.status === 'completed') { %>
                            Order complete. Thank you for your purchase!
                        <% } else if (order.status === 'cancelled') { %>
                            This order has been cancelled.
                        <% } %>
                    </p>
                </div>
            </div>

            <% if (order.tracking_number) { %>
            <!-- Tracking Information -->
            <div class="card mb-3 border-primary">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-truck"></i> Tracking</h6>
                    <p class="mb-1"><strong>Number:</strong> <%= order.tracking_number %></p>
                    <% if (order.tracking_url) { %>
                    <a href="<%= order.tracking_url %>" target="_blank" class="btn btn-primary btn-sm mt-2 w-100">
                        <i class="bi bi-box-arrow-up-right"></i> Track Your Parcel
                    </a>
                    <% } %>
                </div>
            </div>
            <% } %>

            <% if (order.notes) { %>
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-title">Order Notes</h6>
                    <p class="mb-0"><%= order.notes %></p>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
