<%- include('../partials/header') %>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Collection</h2>
        <div>
            <a href="/user/collection/add?status=<%= status %>" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Card
            </a>
            <a href="/user/collection/export?status=<%= status %>" class="btn btn-outline-primary">
                <i class="bi bi-download"></i> Export CSV
            </a>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link <%= status === 'have' ? 'active' : '' %>" href="/user/collection?status=have">
                Cards I Have
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= status === 'want' ? 'active' : '' %>" href="/user/collection?status=want">
                Cards I Want
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="/user/collection/matches">
                Collection Matcher
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="/user/collection/sets">
                <i class="bi bi-grid-3x3-gap"></i> Browse Sets
            </a>
        </li>
    </ul>

    <% if (status === 'have') { %>
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="/user/collection?status=have" class="btn btn-sm <%= !ownership ? 'btn-primary' : 'btn-outline-secondary' %>">All</a>
        <% Object.entries(ownershipStatuses).forEach(([value, label]) => { %>
        <a href="/user/collection?status=have&ownership=<%= value %>"
           class="btn btn-sm <%= ownership === value ? 'btn-primary' : 'btn-outline-secondary' %>"><%= label %></a>
        <% }) %>
        <% const paidTotal = collection.reduce((sum, i) => sum + (i.price_paid ? parseFloat(i.price_paid) * (i.quantity || 1) : 0), 0); %>
        <% if (paidTotal > 0) { %>
        <span class="ms-auto align-self-center small text-muted">Paid: NZD $<%= paidTotal.toFixed(2) %></span>
        <% } %>
    </div>
    <% } %>

    <% if (status === 'have' && !ownership && completionStats && Object.keys(completionStats).length > 0) { %>
    <% Object.entries(completionStats).forEach(([setName, setData]) => { %>
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong><%= setName %></strong>
            <span class="text-muted small"><%= setData.have %> / <%= setData.total %> cards &middot; <%= setData.pct %>%</span>
        </div>
        <div class="card-body pb-2">
            <div class="progress mb-3" style="height: 10px;">
                <div class="progress-bar bg-success" style="width: <%= setData.pct %>%"></div>
            </div>
            <div class="row g-2">
                <% setData.inserts.forEach(insert => { %>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span class="text-truncate me-2"><%= insert.insert_list %></span>
                        <span class="text-nowrap"><%= insert.have %>/<%= insert.total %></span>
                    </div>
                    <div class="progress" style="height: 5px;">
                        <div class="progress-bar <%= insert.pct === 100 ? 'bg-success' : 'bg-primary' %>"
                             style="width: <%= insert.pct %>%"></div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </div>
    <% }); %>
    <% } %>

    <% if (figurines && figurines.length > 0) { %>
    <h5 class="text-muted mb-2"><i class="bi bi-stars"></i> Figurines</h5>
    <div class="table-responsive mb-4">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Supplier</th>
                    <th>SKU</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% figurines.forEach(item => { %>
                <tr>
                    <td>
                        <% if (item.image_url) { %>
                        <img src="<%= item.image_url %>" style="width:32px;height:32px;object-fit:contain;border-radius:4px;" class="me-2">
                        <% } %>
                        <a href="/figurines/<%= item.id %>"><strong><%= item.product_name %></strong></a>
                    </td>
                    <td><%= item.supplier || '-' %></td>
                    <td class="text-muted small"><%= item.sku || '-' %></td>
                    <td>NZD $<%= item.price_nzd ? parseFloat(item.price_nzd).toFixed(2) : '-' %></td>
                    <td>
                        <form action="/user/collection/toggle-figurine/<%= item.id %>" method="POST" class="d-inline">
                            <input type="hidden" name="status" value="<%= status %>">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove from collection"
                                    onclick="return confirmDelete('Remove this figurine from your collection?')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <% } %>

    <% if (collection && collection.length > 0) { %>
    <% if (figurines && figurines.length > 0) { %>
    <h5 class="text-muted mb-2"><i class="bi bi-collection"></i> Cards</h5>
    <% } %>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Card Name</th>
                    <th>Set</th>
                    <th>Number</th>
                    <th>Year</th>
                    <th>Type</th>
                    <th>Qty</th>
                    <% if (status === 'have') { %><th>Details</th><% } %>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% collection.forEach(item => { %>
                <tr>
                    <td><strong><%= item.card_name %></strong></td>
                    <td><%= item.set_name || '-' %></td>
                    <td><%= item.card_number || '-' %></td>
                    <td><%= item.year || '-' %></td>
                    <td><%= item.sport_type || '-' %></td>
                    <td><%= item.quantity %></td>
                    <% if (status === 'have') { %>
                    <td class="small">
                        <% if (item.is_graded) { %>
                        <span class="badge bg-dark" title="<%= item.cert_number ? 'Cert ' + item.cert_number : '' %>"><%= item.grade_company || 'Graded' %> <%= item.grade_value || '' %></span>
                        <% } %>
                        <% if (item.ownership_status && item.ownership_status !== 'in_collection') { %>
                        <span class="badge <%= { in_transit: 'bg-warning text-dark', for_sale: 'bg-info text-dark', sold: 'bg-secondary' }[item.ownership_status] %>"><%= ownershipStatuses[item.ownership_status] %></span>
                        <% } %>
                        <% if (item.condition && !item.is_graded) { %><span class="text-muted"><%= conditions[item.condition] %></span><% } %>
                        <% if (item.price_paid != null) { %><div class="text-muted">Paid $<%= parseFloat(item.price_paid).toFixed(2) %></div><% } %>
                    </td>
                    <% } %>
                    <td class="small text-muted"><%= item.notes || '-' %></td>
                    <td>
                        <a href="/user/collection/<%= item.id %>/edit" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form action="/user/collection/<%= item.id %>/delete" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirmDelete('Delete this card from your collection?')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <% } else if (!figurines || figurines.length === 0) { %>
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Your <%= status %> list is empty.
        <a href="/user/collection/add?status=<%= status %>" class="alert-link">Add your first card!</a>
    </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
