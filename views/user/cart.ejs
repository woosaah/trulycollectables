<%- include('../partials/header') %>

<div class="container my-4">
    <h2 class="mb-4">Shopping Cart</h2>

    <% if (stockError) { %>
    <div class="alert alert-warning">Sorry, there isn't enough stock available for that item.</div>
    <% } %>

    <% if (cartItems && cartItems.length > 0) { %>
    <div class="row">
        <div class="col-lg-8">
            <% cartItems.forEach(item => { %>
            <div class="cart-item">
                <div class="row align-items-center">
                    <div class="col-md-2">
                        <% if (item.card_id) { %>
                            <img src="<%= item.variation_image || item.image_front || '/images/placeholder.png' %>" class="img-fluid" alt="<%= item.card_name %>">
                        <% } else if (item.figurine_id) { %>
                            <img src="<%= item.figurine_image || '/images/placeholder.png' %>" class="img-fluid" alt="<%= item.figurine_name %>">
                        <% } else if (item.accessory_id) { %>
                            <% if (item.accessory_image) { %>
                                <img src="<%= item.accessory_image %>" class="img-fluid" alt="<%= item.accessory_name %>">
                            <% } else { %>
                                <div class="d-flex align-items-center justify-content-center bg-light rounded" style="height: 80px;">
                                    <i class="bi bi-box-seam text-muted" style="font-size: 2rem;"></i>
                                </div>
                            <% } %>
                        <% } %>
                    </div>
                    <div class="col-md-4">
                        <h6 class="mb-1"><%= item.card_name || item.figurine_name || item.accessory_name %></h6>
                        <% if (item.set_name) { %>
                        <p class="text-muted small mb-0"><%= item.set_name %></p>
                        <% } %>
                        <% if (item.accessory_category) { %>
                        <span class="badge bg-secondary small"><%= item.accessory_category %></span>
                        <% } %>
                        <% if (item.variation_name) { %>
                        <span class="badge bg-primary-subtle text-primary small"><%= item.variation_name %></span>
                        <% } %>
                        <% if (item.variant_label) { %>
                        <span class="text-muted small d-block"><%= item.variant_label %></span>
                        <% } %>
                    </div>
                    <div class="col-md-2">
                        <%
                            let unitPrice;
                            if (item.card_id) {
                                unitPrice = item.variation_price ? parseFloat(item.variation_price) : parseFloat(item.card_price);
                            } else if (item.figurine_id) {
                                unitPrice = parseFloat(item.figurine_price);
                            } else if (item.unit_price) {
                                unitPrice = parseFloat(item.unit_price);
                            } else {
                                unitPrice = parseFloat(item.accessory_price);
                            }
                        %>
                        <p class="mb-0">NZD $<%= unitPrice.toFixed(2) %></p>
                    </div>
                    <div class="col-md-2">
                        <form action="/user/cart/<%= item.id %>/update" method="POST" class="d-flex">
                            <input type="number" class="form-control form-control-sm" name="quantity"
                                   value="<%= item.quantity %>" min="1"
                                   max="<%= item.card_stock || item.figurine_stock || item.accessory_stock %>"
                                   onchange="this.form.submit()">
                        </form>
                    </div>
                    <div class="col-md-2 text-end">
                        <form action="/user/cart/<%= item.id %>/remove" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirmDelete('Remove this item from cart?')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Order Summary</h5>
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Items:</span>
                        <span><%= cartItems.length %></span>
                    </div>
                    <% if (isSocietyMember) { %>
                    <div class="mb-2">
                        <span class="badge bg-success"><i class="bi bi-star-fill"></i> Society Member Pricing Applied</span>
                    </div>
                    <% } %>
                    <div class="d-flex justify-content-between mb-3">
                        <strong>Total:</strong>
                        <strong class="text-primary">NZD $<%= total.toFixed(2) %></strong>
                    </div>
                    <a href="/user/checkout" class="btn btn-primary w-100">Proceed to Checkout</a>
                    <a href="/accessories" class="btn btn-outline-primary w-100 mt-2">Continue Shopping</a>
                </div>
            </div>
        </div>
    </div>
    <% } else { %>
    <div class="alert alert-info">
        <i class="bi bi-cart-x"></i> Your cart is empty.
        <a href="/accessories" class="alert-link">Start shopping!</a>
    </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
