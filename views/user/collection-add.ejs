<%- include('../partials/header') %>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center mb-4 gap-3">
                <a href="/user/collection?status=<%= status %>" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="mb-0">Add to My Collection</h2>
            </div>

            <!-- Status toggle -->
            <div class="btn-group mb-4 w-100" role="group">
                <a href="/user/collection/add?status=have"
                   class="btn <%= status === 'have' ? 'btn-primary' : 'btn-outline-primary' %>">
                    <i class="bi bi-check-circle"></i> I Have This
                </a>
                <a href="/user/collection/add?status=want"
                   class="btn <%= status === 'want' ? 'btn-warning' : 'btn-outline-warning' %>">
                    <i class="bi bi-bookmark"></i> I Want This
                </a>
            </div>

            <!-- Search box -->
            <div class="card mb-4">
                <div class="card-body">
                    <label for="cardSearch" class="form-label fw-semibold">Search for a card</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control form-control-lg" id="cardSearch"
                               placeholder="Type card name, set, or manufacturer…" autocomplete="off">
                    </div>
                    <small class="text-muted">Searches our catalogue and existing community submissions.</small>
                </div>
            </div>

            <!-- Search results -->
            <div id="searchResults" class="d-none">

                <!-- Catalogue results -->
                <div id="catalogueSection" class="d-none mb-4">
                    <h6 class="text-muted text-uppercase fw-semibold mb-2">
                        <i class="bi bi-shop"></i> In Our Catalogue
                    </h6>
                    <div id="catalogueList" class="list-group"></div>
                </div>

                <!-- Pending / community results -->
                <div id="pendingSection" class="d-none mb-4">
                    <h6 class="text-muted text-uppercase fw-semibold mb-2">
                        <i class="bi bi-people"></i> Community Submissions
                    </h6>
                    <div id="pendingList" class="list-group"></div>
                </div>

                <!-- No results nudge -->
                <div id="noResults" class="d-none">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        No matches found. Fill in the details below to submit this card.
                    </div>
                </div>

            </div>

            <!-- Manual submission form (hidden until no results, or user clicks "submit new") -->
            <div id="manualForm" class="d-none">
                <h5 class="mb-3">
                    <i class="bi bi-plus-circle"></i> Submit a New Card
                </h5>

                <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        <% errors.forEach(e => { %><li><%= e.msg %></li><% }); %>
                    </ul>
                </div>
                <% } %>

                <div class="card">
                    <div class="card-body">
                        <form action="/user/collection/add" method="POST" enctype="multipart/form-data">
                            <input type="hidden" name="status" value="<%= status %>">

                            <div class="mb-3">
                                <label for="card_name" class="form-label">Card Name *</label>
                                <input type="text" class="form-control" id="card_name_input" name="card_name"
                                       value="<%= formData.card_name || '' %>" required>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Set Name</label>
                                    <input type="text" class="form-control" name="set_name"
                                           value="<%= formData.set_name || '' %>">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Card Number</label>
                                    <input type="text" class="form-control" name="card_number"
                                           value="<%= formData.card_number || '' %>">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Manufacturer</label>
                                    <input type="text" class="form-control" name="manufacturer"
                                           value="<%= formData.manufacturer || '' %>">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Year</label>
                                    <input type="number" class="form-control" name="year"
                                           value="<%= formData.year || '' %>" min="1900" max="2099">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Category *</label>
                                    <select class="form-select" name="card_category" required>
                                        <option value="sport" <%= formData.card_category === 'sport' ? 'selected' : '' %>>Sport</option>
                                        <option value="non_sport" <%= (!formData.card_category || formData.card_category === 'non_sport') ? 'selected' : '' %>>Non-Sport</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Sport / Type</label>
                                    <select class="form-select" name="sport_type">
                                        <option value="">Select…</option>
                                        <option value="Basketball">Basketball</option>
                                        <option value="Pokemon">Pokemon</option>
                                        <option value="Magic: The Gathering">Magic: The Gathering</option>
                                        <option value="Baseball">Baseball</option>
                                        <option value="Football">Football</option>
                                        <option value="Cricket">Cricket</option>
                                        <option value="Rugby">Rugby</option>
                                        <option value="Rugby League">Rugby League</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Insert / Subset</label>
                                <input type="text" class="form-control" name="insert_list"
                                       value="<%= formData.insert_list || '' %>"
                                       placeholder="e.g. Prizm, Refractor, Base Set">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Photo <span class="text-muted">(optional — helps the admin add it to the catalogue)</span></label>
                                <input type="file" class="form-control" name="image_front" accept="image/*">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Notes</label>
                                <textarea class="form-control" name="notes" rows="2"><%= formData.notes || '' %></textarea>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-plus-circle"></i> Submit & Add to Collection
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="hideManualForm">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

<script>
const searchInput = document.getElementById('cardSearch');
const searchResults = document.getElementById('searchResults');
const catalogueSection = document.getElementById('catalogueSection');
const catalogueList = document.getElementById('catalogueList');
const pendingSection = document.getElementById('pendingSection');
const pendingList = document.getElementById('pendingList');
const noResults = document.getElementById('noResults');
const manualForm = document.getElementById('manualForm');
const status = '<%= status %>';

let debounceTimer;

searchInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const q = searchInput.value.trim();
    if (q.length < 2) {
        searchResults.classList.add('d-none');
        return;
    }
    debounceTimer = setTimeout(() => doSearch(q), 300);
});

async function doSearch(q) {
    try {
        const res = await fetch('/user/collection/search.json?q=' + encodeURIComponent(q));
        const data = await res.json();
        renderResults(data);
    } catch (e) {
        console.error(e);
    }
}

function renderResults({ catalogue, pending }) {
    searchResults.classList.remove('d-none');

    if (catalogue.length > 0) {
        catalogueSection.classList.remove('d-none');
        catalogueList.innerHTML = catalogue.map(c => `
            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">${esc(c.card_name)}</div>
                    <small class="text-muted">
                        ${ c.set_name ? esc(c.set_name) + ' · ' : '' }
                        ${ c.year ? c.year + ' · ' : '' }
                        ${ c.manufacturer ? esc(c.manufacturer) : '' }
                    </small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    ${ c.image_front ? `<img src="${esc(c.image_front)}" height="40" style="object-fit:contain">` : '' }
                    <button class="btn btn-sm btn-primary" onclick="addCatalogue(${c.id}, this)">
                        Add
                    </button>
                </div>
            </div>
        `).join('');
    } else {
        catalogueSection.classList.add('d-none');
    }

    if (pending.length > 0) {
        pendingSection.classList.remove('d-none');
        pendingList.innerHTML = pending.map(p => `
            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">${esc(p.card_name)}</div>
                    <small class="text-muted">
                        ${ p.set_name ? esc(p.set_name) + ' · ' : '' }
                        ${ p.year ? p.year + ' · ' : '' }
                        ${ p.manufacturer ? esc(p.manufacturer) : '' }
                        <span class="badge bg-secondary">${p.collection_count} collector${ p.collection_count != 1 ? 's' : '' }</span>
                    </small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    ${ p.image_front ? `<img src="${esc(p.image_front)}" height="40" style="object-fit:contain">` : '' }
                    <button class="btn btn-sm btn-outline-primary" onclick="addPending(${p.id}, this)">
                        Add
                    </button>
                </div>
            </div>
        `).join('');
    } else {
        pendingSection.classList.add('d-none');
    }

    const hasAny = catalogue.length > 0 || pending.length > 0;
    noResults.classList.toggle('d-none', hasAny);

    if (!hasAny) {
        showManualForm(searchInput.value.trim());
    }
}

async function addCatalogue(cardId, btn) {
    await addToCollection({ card_id: cardId }, btn);
}

async function addPending(pendingId, btn) {
    await addToCollection({ pending_card_id: pendingId }, btn);
}

async function addToCollection(extraFields, btn) {
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
    }
    try {
        const params = new URLSearchParams({ status, ...extraFields });
        const res = await fetch('/user/collection/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'x-csrf-token': '<%= locals.csrfToken || "" %>'
            },
            body: params.toString()
        });
        // Server redirects on success — final URL won't be the /add page
        const succeeded = res.ok && !res.url.includes('/collection/add');
        if (succeeded) {
            if (btn) {
                btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Added';
                btn.classList.remove('btn-primary', 'btn-outline-primary');
                btn.classList.add('btn-success');
            }
        } else {
            throw new Error('Failed');
        }
    } catch (e) {
        if (btn) {
            btn.disabled = false;
            btn.textContent = 'Add';
        }
        alert('Could not add card. Please try again.');
    }
}

function showManualForm(prefill) {
    manualForm.classList.remove('d-none');
    if (prefill) document.getElementById('card_name_input').value = prefill;
    manualForm.scrollIntoView({ behavior: 'smooth' });
}

document.getElementById('hideManualForm').addEventListener('click', () => {
    manualForm.classList.add('d-none');
});

// "Not what you're looking for?" link at bottom of results
document.addEventListener('click', e => {
    if (e.target.id === 'submitNewBtn') showManualForm(searchInput.value.trim());
});

// Show manual form immediately if there were validation errors
<% if (errors && errors.length > 0) { %>
manualForm.classList.remove('d-none');
<% } %>

function esc(str) {
    const d = document.createElement('div');
    d.textContent = String(str || '');
    return d.innerHTML;
}
</script>

<%- include('../partials/footer') %>
