    <!-- Footer -->
    <footer class="bg-white border-top mt-5 py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="text-primary">Truly Collectables</h5>
                    <p class="text-muted small">Your trusted source for trading cards and collectibles.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled">
                        <li><a href="/cards" class="text-decoration-none text-dark">Browse Cards</a></li>
                        <li><a href="/accessories" class="text-decoration-none text-dark">Accessories</a></li>
                        <li><a href="/figurines" class="text-decoration-none text-dark">Figurines</a></li>
                        <% if (user) { %>
                        <li><a href="/user/collection" class="text-decoration-none text-dark">My Collection</a></li>
                        <% } %>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Account</h6>
                    <ul class="list-unstyled">
                        <% if (user) { %>
                        <li><a href="/user/dashboard" class="text-decoration-none text-dark">Dashboard</a></li>
                        <li><a href="/user/orders" class="text-decoration-none text-dark">Orders</a></li>
                        <% } else { %>
                        <li><a href="/auth/login" class="text-decoration-none text-dark">Login</a></li>
                        <li><a href="/auth/register" class="text-decoration-none text-dark">Register</a></li>
